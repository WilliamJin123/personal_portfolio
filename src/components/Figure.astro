---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  aspect?: string;
  /** 'frame' draws a hairline border; 'bleed' lets the image touch. */
  frame?: 'frame' | 'bleed';
  /** 'narrow' fits the reading column; 'wide' breaks out to ~960px; 'full' breaks the column entirely. */
  width?: 'narrow' | 'wide' | 'full';
}

const {
  src,
  alt = '',
  caption,
  aspect = '16/9',
  frame = 'frame',
  width = 'narrow'
} = Astro.props;

const ratioLabel = aspect.replace('/', ' : ');
---
<figure class={`fig fig-${frame} fig-w-${width}`}>
  <div class="fig-frame" style={`aspect-ratio: ${aspect};`}>
    {src ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <div class="fig-placeholder" aria-label={`image placeholder, ${ratioLabel}`}>
        <span class="fig-label mono">{ratioLabel}</span>
      </div>
    )}
  </div>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 32px 0; }
  .fig-w-wide { margin-left: clamp(-80px, -8vw, 0px); margin-right: clamp(-80px, -8vw, 0px); }
  .fig-w-full { margin-left: calc(50% - 50vw + 20px); margin-right: calc(50% - 50vw + 20px); }

  .fig-frame {
    position: relative;
    width: 100%;
    background: var(--canvas-card);
    overflow: hidden;
  }
  .fig-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fig-frame .fig-placeholder {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, var(--canvas-card) 0%, var(--canvas-raise) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fig-label {
    font-size: 10px;
    color: var(--ink-faint);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .fig-frame { border: 1px solid var(--rule); }
  .fig-bleed .fig-frame { border: none; }

  figcaption {
    margin-top: 14px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }

  @media (max-width: 720px) {
    .fig-w-wide,
    .fig-w-full {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
