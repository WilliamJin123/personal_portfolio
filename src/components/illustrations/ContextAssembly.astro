---
// Five sources flow into a central container filled with token glyphs.
// All in-svg text removed — fill in by adding <text> elements where wanted.
---
<svg
  class="ill-ctx"
  viewBox="0 0 460 280"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
>
  <!-- Source boxes (5) -->
  <g class="srcs">
    <rect class="frame" x="20" y="36"  width="110" height="22" />
    <rect class="frame" x="20" y="66"  width="110" height="22" />
    <rect class="frame" x="20" y="96"  width="110" height="22" />
    <rect class="frame" x="20" y="126" width="110" height="22" />
    <rect class="frame" x="20" y="156" width="110" height="22" />
  </g>

  <!-- Flow lines into the central container -->
  <g class="flows">
    <path class="flow" d="M 130 47 C 175 47, 200 100, 230 110" />
    <path class="flow" d="M 130 77 C 175 77, 200 118, 230 124" />
    <path class="flow" d="M 130 107 C 175 107, 200 132, 230 138" />
    <path class="flow" d="M 130 137 C 175 137, 200 148, 230 152" />
    <path class="flow" d="M 130 167 C 175 167, 200 162, 230 166" />
  </g>

  <!-- Traveling dot on the middle flow line -->
  <circle r="2.2" class="data-dot">
    <animateMotion
      dur="5.5s"
      repeatCount="indefinite"
      path="M 130 107 C 175 107, 200 132, 230 138"
    />
  </circle>

  <!-- Central container -->
  <rect class="ctx" x="230" y="50" width="180" height="180" />

  <!-- Token glyphs -->
  <g class="tokens">
    <line class="tk" x1="240" y1="72"  x2="278" y2="72"/>
    <line class="tk" x1="282" y1="72"  x2="312" y2="72"/>
    <line class="tk" x1="316" y1="72"  x2="346" y2="72"/>
    <line class="tk" x1="350" y1="72"  x2="380" y2="72"/>
    <line class="tk" x1="384" y1="72"  x2="400" y2="72"/>

    <line class="tk" x1="240" y1="88"  x2="270" y2="88"/>
    <line class="tk" x1="274" y1="88"  x2="306" y2="88"/>
    <line class="tk" x1="310" y1="88"  x2="342" y2="88"/>
    <line class="tk" x1="346" y1="88"  x2="378" y2="88"/>
    <line class="tk" x1="382" y1="88"  x2="400" y2="88"/>

    <line class="tk" x1="240" y1="104" x2="276" y2="104"/>
    <line class="tk" x1="280" y1="104" x2="312" y2="104"/>
    <line class="tk" x1="316" y1="104" x2="340" y2="104"/>
    <line class="tk" x1="344" y1="104" x2="382" y2="104"/>

    <line class="tk" x1="240" y1="120" x2="268" y2="120"/>
    <line class="tk" x1="272" y1="120" x2="306" y2="120"/>
    <line class="tk" x1="310" y1="120" x2="346" y2="120"/>
    <line class="tk" x1="350" y1="120" x2="386" y2="120"/>
    <line class="tk" x1="390" y1="120" x2="400" y2="120"/>

    <line class="tk" x1="240" y1="136" x2="274" y2="136"/>
    <line class="tk" x1="278" y1="136" x2="308" y2="136"/>
    <line class="tk" x1="312" y1="136" x2="340" y2="136"/>
    <line class="tk" x1="344" y1="136" x2="378" y2="136"/>
    <line class="tk" x1="382" y1="136" x2="400" y2="136"/>

    <line class="tk" x1="240" y1="152" x2="278" y2="152"/>
    <line class="tk" x1="282" y1="152" x2="306" y2="152"/>
    <line class="tk" x1="310" y1="152" x2="344" y2="152"/>

    <line class="tk" x1="240" y1="168" x2="270" y2="168"/>
    <line class="tk" x1="274" y1="168" x2="312" y2="168"/>
    <line class="tk" x1="316" y1="168" x2="344" y2="168"/>
    <line class="tk" x1="348" y1="168" x2="380" y2="168"/>

    <line class="tk" x1="240" y1="184" x2="278" y2="184"/>
    <line class="tk" x1="282" y1="184" x2="318" y2="184"/>
    <line class="tk" x1="322" y1="184" x2="356" y2="184"/>
    <line class="tk" x1="360" y1="184" x2="394" y2="184"/>

    <line class="tk" x1="240" y1="200" x2="266" y2="200"/>
    <line class="tk" x1="270" y1="200" x2="304" y2="200"/>
    <line class="tk" x1="308" y1="200" x2="340" y2="200"/>

    <line class="tk" x1="240" y1="216" x2="276" y2="216"/>
    <line class="tk" x1="280" y1="216" x2="308" y2="216"/>
    <line class="tk cursor" x1="312" y1="210" x2="312" y2="222"/>
  </g>

  <!-- Output arrow -->
  <path class="flow-out" d="M 410 140 L 440 140" />
  <path class="flow-out" d="M 434 136 L 440 140 L 434 144" />
</svg>

<style>
  .ill-ctx { width: 100%; height: auto; display: block; max-width: 500px; margin: 0 auto; }
  .ill-ctx .frame    { fill: none; stroke: var(--ink); stroke-width: 0.8; }
  .ill-ctx .ctx      { fill: var(--paper); stroke: var(--ink); stroke-width: 1; }
  .ill-ctx .flow     { fill: none; stroke: var(--ink); stroke-width: 0.5; opacity: 0.5; }
  .ill-ctx .flow-out { fill: none; stroke: var(--ink); stroke-width: 0.9; stroke-linecap: round; stroke-linejoin: round; }
  .ill-ctx .tk       { stroke: var(--ink); stroke-width: 1.2; stroke-linecap: round; opacity: 0.55; }
  .ill-ctx .cursor   { stroke-width: 1.2; animation: ill-ctx-blink 1.1s steps(2, jump-none) infinite; }
  .ill-ctx .data-dot { fill: var(--ink); opacity: 0.7; }
  @keyframes ill-ctx-blink {
    0%, 49.9% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>
