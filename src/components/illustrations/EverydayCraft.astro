---
// Three line-art glyphs wired left → right.
// All in-svg text removed.
---
<svg
  class="ill-evd"
  viewBox="0 0 460 180"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
>
  <!-- Window with cursor -->
  <g transform="translate(20, 44)">
    <rect class="frame" x="0" y="0" width="110" height="86" />
    <line class="frame-line" x1="0" y1="14" x2="110" y2="14" />
    <circle class="dot" cx="6"  cy="7" r="1.5" />
    <circle class="dot" cx="12" cy="7" r="1.5" />
    <circle class="dot" cx="18" cy="7" r="1.5" />
    <line class="frame-line" x1="10" y1="28" x2="64" y2="28" />
    <line class="frame-line" x1="10" y1="38" x2="80" y2="38" />
    <rect class="frame-fill" x="10" y="54" width="42" height="18" rx="2" />
    <path class="cursor-pt" d="M 70 60 L 70 80 L 74 74 L 80 82 L 84 80 L 78 72 L 84 72 Z" />
  </g>

  <!-- Arrow -->
  <path class="flow" d="M 138 87 L 168 87" />
  <path class="flow" d="M 162 84 L 168 87 L 162 90" />

  <!-- Braces glyph -->
  <g transform="translate(176, 44)">
    <rect class="frame" x="0" y="0" width="110" height="86" />
    <path class="frame-line" d="M 30 16 C 22 16, 22 28, 22 43 C 22 58, 22 70, 30 70" fill="none" />
    <path class="frame-line" d="M 80 16 C 88 16, 88 28, 88 43 C 88 58, 88 70, 80 70" fill="none" />
    <line class="frame-line" x1="38" y1="36" x2="72" y2="36" />
    <line class="frame-line" x1="38" y1="46" x2="68" y2="46" />
    <line class="frame-line" x1="38" y1="56" x2="74" y2="56" />
  </g>

  <!-- Arrow -->
  <path class="flow" d="M 294 87 L 324 87" />
  <path class="flow" d="M 318 84 L 324 87 L 318 90" />

  <!-- Cylinder -->
  <g transform="translate(332, 44)">
    <path class="frame-fill-light" d="M 0 12 L 0 76 C 0 84, 22 88, 54 88 C 86 88, 108 84, 108 76 L 108 12 Z" />
    <ellipse class="frame"      cx="54" cy="12" rx="54" ry="8" />
    <ellipse class="frame-line" cx="54" cy="32" rx="52" ry="7" fill="none" />
    <ellipse class="frame-line" cx="54" cy="54" rx="49" ry="6" fill="none" />
  </g>
</svg>

<style>
  .ill-evd { width: 100%; height: auto; display: block; max-width: 520px; margin: 0 auto; }
  .ill-evd .frame            { fill: none; stroke: var(--ink); stroke-width: 0.9; }
  .ill-evd .frame-line       { stroke: var(--ink); stroke-width: 0.5; opacity: 0.6; fill: none; }
  .ill-evd .frame-fill       { fill: var(--ink); }
  .ill-evd .frame-fill-light { fill: var(--ink); fill-opacity: 0.06; stroke: var(--ink); stroke-width: 0.9; }
  .ill-evd .dot              { fill: var(--ink); }
  .ill-evd .flow             { stroke: var(--ink); stroke-width: 0.9; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ill-evd .cursor-pt        { fill: var(--ink); animation: ill-evd-pulse 2.2s ease-in-out infinite; }
  @keyframes ill-evd-pulse {
    0%, 100% { opacity: 0.7; }
    50%      { opacity: 1; }
  }
</style>
