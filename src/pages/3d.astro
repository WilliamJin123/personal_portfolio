---
// 3D mode — the second site: a dark, full-bleed WebGL world. Self-contained
// like index.astro: own theme, fonts, and scripts; inherits nothing from the
// paper site. The scene is "The Drift" (flight 002): one continuous
// scroll-driven drift through open space — nebula banks, a ringed-planet
// flyby, a beacon at the end. The three stations along the route now carry the
// real content, drawn as hairline star-systems floating over the cosmos:
//   01 EXPERIENCE — an orrery (one planet per role)
//   02 PROJECTS   — a galaxy spiral (one star per build)
//   03 CONTACT    — the beacon, where the route ends
// Content is the SAME résumé library the paper site reads (single source of
// truth); the presentation layer lives in studio-content.ts.
// Specs: docs/superpowers/specs/2026-06-10-studio-mode-design.md (shell),
//        docs/superpowers/specs/2026-06-11-3d-drift-design.md (scene)
import { entries } from '../resume/data/entries';
import { tokenize } from '../resume/tokenize';
import { tokensToHtml } from '../resume/html';
import { portfolioMedia } from '../data/portfolio-media';

const toView = (e: (typeof entries)[number]) => {
  const m = portfolioMedia[e.id] ?? {};
  return {
    id: e.id,
    title: e.title,
    role: e.role ?? '',
    subtitle: e.subtitle ?? '',
    dateLabel: e.dateLabel,
    location: e.location ?? '',
    links: e.links ?? [],
    bulletsHtml: e.bullets.map((b) => tokensToHtml(tokenize(b.text))),
    awards: e.awards ?? [],
    grants: e.grants ?? [],
    stack: m.stack ?? [],
  };
};
// `hidden` (portfolio-media) trims an entry from the public site; mirrors index.astro.
const shown = (e: (typeof entries)[number]) => portfolioMedia[e.id]?.hidden !== true;
const studioData = {
  work: entries.filter((e) => e.section === 'experience' && shown(e)).map(toView),
  projects: entries.filter((e) => e.section === 'projects' && shown(e)).map(toView),
};
const studioJson = JSON.stringify(studioData).split('<').join('\\u003c');

const contact = {
  email: 'mailto:w3jin@uwaterloo.ca',
  github: 'https://github.com/WilliamJin123',
  linkedin: 'https://www.linkedin.com/in/william-jin-874b572a1',
  devpost: 'https://devpost.com/jinwilliam-jin',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0b0c0e" />
<title>William Jin — 3D</title>
<meta name="description" content="William Jin — 3D mode. A WebGL drift through the work: experience as an orrery, projects as a galaxy." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@300..600&display=swap" />
<!-- unscoped: studio-content.ts injects the readouts / chips / SVG nodes at
     runtime, so they never receive Astro's scope attribute — these rules must be
     global to reach them (same reason index.astro uses is:global). -->
<style is:global>
  :root{
    --ground:#0b0c0e; --ink:#e7e9ee; --ink2:#c2c6cd; --mute:#8b8f98; --faint:#4a4e57;
    --rule:rgba(231,233,238,.14); --amber:#d08a2e; --amber-rgb:208,138,46; --grant:#5fb98f; --grant-rgb:95,185,143;
    --sans:'Geist',system-ui,sans-serif; --mono:'Geist Mono',ui-monospace,monospace;
    --ease:cubic-bezier(.2,.7,.2,1);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;overflow-x:clip}
  body{background:var(--ground);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  .m{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}

  #studio-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;contain:strict}
  body.no-gl #studio-canvas{display:none}
  /* a barely-there floor of ground colour so DOM text always has minimum contrast
     even where the cosmos brightens behind it */
  body.no-gl{background:radial-gradient(120% 90% at 50% 0%,#101218 0%,var(--ground) 60%)}

  /* top bar — identity left, exit right */
  .bar{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:22px clamp(20px,3vw,44px)}
  .bar .id{color:var(--ink);text-shadow:0 1px 14px rgba(0,0,0,.6)}
  .bar .id .sl{color:var(--amber)}
  .exit{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);text-decoration:none;border:1px solid var(--rule);border-radius:999px;padding:9px 18px;background:rgba(11,12,14,.4);backdrop-filter:blur(6px);transition:border-color .25s,color .25s,box-shadow .25s,transform .25s}
  .exit:hover{border-color:var(--amber);color:var(--amber);transform:translateY(-2px);box-shadow:0 6px 18px rgba(var(--amber-rgb),.18)}

  /* ── hero ── */
  .scn{position:relative;z-index:1;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:0 clamp(20px,3vw,44px) clamp(28px,5vh,56px)}
  .scn.first{justify-content:center;align-items:center;text-align:center}
  .scn.first .greet{color:var(--amber)}
  .scn.first h1{margin-top:18px;font-weight:480;font-size:clamp(34px,5.2vw,64px);letter-spacing:-.03em;line-height:1.05}
  .scn.first .sub{margin-top:16px;color:var(--mute);font-size:14.5px;max-width:50ch;line-height:1.65}
  .nogl-note{display:none;margin-top:18px;color:var(--faint)}
  body.no-gl .nogl-note{display:block}
  .hint{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);color:var(--faint)}
  .hint::after{content:"";display:block;width:1px;height:34px;margin:10px auto 0;background:linear-gradient(var(--faint),transparent);animation:hintPulse 2.6s var(--ease) infinite}
  @keyframes hintPulse{0%,100%{opacity:.35;transform:scaleY(.7)}50%{opacity:1;transform:scaleY(1)}}

  /* ── station shell: a tall scroll range whose panel pins while you read it ── */
  .station{position:relative;z-index:1;min-height:178svh}
  .station.contact{min-height:150svh}
  .panel{position:sticky;top:0;min-height:100svh;display:flex;flex-direction:column;justify-content:center;gap:clamp(16px,2.2vh,26px);max-width:1240px;margin:0 auto;padding:92px clamp(20px,4vw,64px) 60px}

  /* panel header — big ghost numeral + title/sub */
  .panel-head{display:flex;align-items:flex-start;gap:clamp(16px,2vw,26px)}
  .panel-head .pnum{font-family:var(--mono);font-weight:300;font-size:clamp(44px,6vw,82px);line-height:.82;color:transparent;-webkit-text-stroke:1px var(--faint);letter-spacing:.01em;flex-shrink:0}
  .panel-head .pttl{font-size:clamp(21px,2.4vw,31px);font-weight:480;letter-spacing:-.022em;line-height:1}
  .panel-head .psub{margin-top:8px;color:var(--mute);font-size:13px;max-width:52ch;line-height:1.55}

  /* the two-column body: the diagram (open to the cosmos) + a glass readout */
  .sys-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(18px,3vw,52px);align-items:center}
  .sys-stage{position:relative;width:100%;max-width:558px;aspect-ratio:1/1;justify-self:center}
  .sys-svg{width:100%;height:100%;display:block;overflow:visible}
  .sys-svg .plate{stroke:var(--rule);stroke-width:1;opacity:.55;vector-effect:non-scaling-stroke}
  .sys-svg .cardinal{stroke:var(--faint);stroke-width:1;opacity:.55;vector-effect:non-scaling-stroke}
  .sys-svg .orbit{stroke:rgba(231,233,238,.2);stroke-width:1;vector-effect:non-scaling-stroke}
  .sys-svg .tick{stroke:var(--faint);stroke-width:1;opacity:.3;vector-effect:non-scaling-stroke}
  .sys-svg .arm{stroke:var(--faint);stroke-width:1.2;opacity:.46;vector-effect:non-scaling-stroke;stroke-linejoin:round;stroke-linecap:round}
  .sys-svg .dot{fill:var(--ink2);transition:fill .35s}
  .sys-svg .dot.on{fill:var(--amber)}
  .sys-svg .halo{filter:blur(3px)}
  .sys-svg .star-core,.sys-svg .gcore{filter:drop-shadow(0 0 7px rgba(var(--amber-rgb),.75))}
  .sys-svg .nnum{font-family:var(--mono);font-size:12px;letter-spacing:.02em;fill:var(--faint);paint-order:stroke;stroke:var(--ground);stroke-width:3px;stroke-linejoin:round;transition:fill .35s}
  .sys-svg .nnum.on{fill:var(--amber);font-size:14px}

  /* glass instrument readout */
  .sys-readout{align-self:center;width:100%;max-height:76svh;overflow-y:auto;padding:24px clamp(20px,1.6vw,28px);border:1px solid var(--rule);border-radius:15px;background:rgba(12,13,16,.5);backdrop-filter:blur(8px) saturate(1.1);-webkit-backdrop-filter:blur(8px) saturate(1.1);scrollbar-width:thin;scrollbar-color:var(--faint) transparent}
  .sys-readout::-webkit-scrollbar{width:6px}
  .sys-readout::-webkit-scrollbar-thumb{background:var(--faint);border-radius:6px}
  .ro-in{animation:roIn .5s var(--ease) both}
  @keyframes roIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .ro-kind{color:var(--amber);opacity:.85;margin-bottom:11px}
  .ro-title{font-size:clamp(19px,1.9vw,26px);font-weight:500;letter-spacing:-.02em;line-height:1.12}
  .ro-meta{margin-top:8px;color:var(--mute);text-transform:none;letter-spacing:.02em;font-size:11.5px}
  .ro-meta .dot{margin:0 8px;color:var(--faint)}
  .ro-honors{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}
  .ro-honors span{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;letter-spacing:.02em;padding:5px 11px;border-radius:999px;animation:roIn .5s var(--ease) both;animation-delay:calc(.05s + var(--ai)*.05s)}
  .ro-honors .award{color:var(--amber);border:1px solid rgba(var(--amber-rgb),.42)}
  .ro-honors .grant{color:var(--grant);border:1px solid rgba(var(--grant-rgb),.42)}
  .ro-honors svg{width:13px;height:13px}
  .ro-bul{list-style:none;margin-top:17px}
  .rb{position:relative;padding-left:18px;margin-bottom:11px;font-size:13.5px;line-height:1.62;color:var(--ink2);animation:roIn .5s var(--ease) both;animation-delay:calc(.08s + var(--bi)*.05s)}
  .rb::before{content:"–";position:absolute;left:0;color:var(--faint)}
  .rb .rbold{color:var(--ink);font-weight:600}
  .rb .rlink{color:var(--amber);text-decoration:none;border-bottom:1px solid rgba(var(--amber-rgb),.3)}
  .ro-stack{display:flex;flex-wrap:wrap;column-gap:8px;row-gap:8px;margin-top:18px}
  .chip{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:12px;color:var(--ink2);border:1px solid rgba(231,233,238,.22);border-radius:999px;padding:6px 11px;background:rgba(255,255,255,.045);transition:border-color .2s,color .2s}
  .chip .ic{width:14px;height:14px;flex-shrink:0;background:var(--mute);-webkit-mask:var(--i) center/contain no-repeat;mask:var(--i) center/contain no-repeat;transition:background .2s}
  .chip:hover{border-color:rgba(var(--amber-rgb),.5);color:var(--ink)}
  .chip:hover .ic{background:var(--amber)}
  .ro-links{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:18px}
  .ro-link{font-family:var(--mono);font-size:12px;letter-spacing:.02em;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule);padding-bottom:2px;transition:color .2s,border-color .2s}
  .ro-link:hover{color:var(--amber);border-color:var(--amber)}

  /* footer of each panel: legend (all names) + counter/nav */
  .sys-foot{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
  .sys-legend{display:flex;flex-wrap:wrap;gap:7px 12px;flex:1;min-width:0}
  .sys-leg{display:inline-flex;align-items:baseline;gap:7px;font-family:var(--mono);font-size:12px;letter-spacing:.01em;color:var(--mute);background:none;border:none;border-bottom:1px solid transparent;padding:3px 0;cursor:pointer;transition:color .2s,border-color .2s}
  .sys-leg .ln{font-size:10px;color:var(--faint)}
  .sys-leg:hover{color:var(--ink)}
  .sys-leg.on{color:var(--amber);border-bottom-color:rgba(var(--amber-rgb),.5)}
  .sys-leg.on .ln{color:var(--amber)}
  .sys-nav{display:flex;align-items:center;gap:14px;flex-shrink:0}
  .sys-nav button{width:31px;height:31px;display:grid;place-items:center;border:1px solid var(--rule);border-radius:50%;background:rgba(11,12,14,.35);color:var(--ink);font-size:15px;line-height:1;cursor:pointer;transition:border-color .2s,color .2s}
  .sys-nav button:hover{border-color:var(--amber);color:var(--amber)}
  .sys-count{white-space:nowrap;color:var(--mute)}

  /* reveal — header / body / footer rise in when the station arrives */
  .panel-head,.sys-grid,.sys-foot{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
  .panel.in .panel-head{opacity:1;transform:none}
  .panel.in .sys-grid{opacity:1;transform:none;transition-delay:.09s}
  .panel.in .sys-foot{opacity:1;transform:none;transition-delay:.18s}

  /* ── contact ── */
  .panel.contact-panel{align-items:center;text-align:center;gap:24px;opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform .9s var(--ease)}
  .panel.contact-panel.in{opacity:1;transform:none}
  .contact-panel .c-eyebrow{color:var(--amber)}
  .contact-panel h2{font-size:clamp(32px,5.4vw,66px);font-weight:300;letter-spacing:-.035em;line-height:1.04}
  .contact-panel h2 b{font-weight:500}
  .contact-panel .c-sub{color:var(--mute);max-width:48ch;line-height:1.62;font-size:14.5px}
  .c-links{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:6px}
  .c-link{font-family:var(--mono);font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink);text-decoration:none;border:1px solid var(--rule);border-radius:999px;padding:13px 24px;background:rgba(11,12,14,.35);backdrop-filter:blur(6px);transition:border-color .25s,color .25s,transform .25s,box-shadow .25s}
  .c-link:hover{border-color:var(--amber);color:var(--amber);transform:translateY(-3px);box-shadow:0 10px 26px rgba(var(--amber-rgb),.18)}
  .c-where{margin-top:20px;color:var(--faint)}
  .c-where .dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--grant);margin-right:7px;vertical-align:middle;box-shadow:0 0 8px var(--grant)}

  /* letterbox — the film moment when crossing a station boundary */
  .lbox .lbar{position:fixed;left:0;width:100%;height:9vh;background:#06070a;z-index:60;transform:scaleY(0);transition:transform .55s cubic-bezier(.7,0,.3,1);pointer-events:none}
  .lbox .lbar.top{top:0;transform-origin:top center}
  .lbox .lbar.bot{bottom:0;transform-origin:bottom center}
  .lbox.on .lbar{transform:scaleY(1)}
  .lbox .card{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:61;font-family:var(--mono);font-size:12px;letter-spacing:.34em;text-transform:uppercase;color:var(--ink);opacity:0;transition:opacity .45s ease .12s;pointer-events:none;white-space:nowrap}
  .lbox.on .card{opacity:1}
  .lbox .card .ax{color:var(--amber)}

  /* scroll readout HUD */
  .hud{position:fixed;left:18px;bottom:15px;z-index:40;font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--faint);text-transform:uppercase;pointer-events:none;display:flex;gap:8px}
  .hud .hv{color:var(--mute)}

  /* mode shutter — mirror of the paper site's */
  .shutter{position:fixed;left:0;top:-2vh;width:100%;height:104vh;z-index:200;pointer-events:none;visibility:hidden}
  .shutter .sedge{position:absolute;left:0;top:-1px;width:100%;height:2px;background:var(--amber);box-shadow:0 0 18px rgba(var(--amber-rgb),.6)}
  .shutter.cover{visibility:visible;background:#eceef1;transform:translateY(103%);animation:shCover .5s cubic-bezier(.76,0,.24,1) forwards}
  .shutter.reveal{visibility:visible;background:var(--ground);transform:translateY(0);animation:shReveal .6s cubic-bezier(.7,0,.22,1) .06s both}
  @keyframes shCover{to{transform:translateY(0)}}
  @keyframes shReveal{to{transform:translateY(103%)}}

  @media (max-width:880px){
    /* drop the sticky pin: panels flow as normal full sections (the WebGL still
       drifts on scroll), so tall readouts never clip inside a centred pin */
    .station,.station.contact{min-height:auto}
    .panel{position:static;min-height:auto;justify-content:flex-start;padding:96px clamp(20px,5vw,40px) 72px}
    .panel.contact-panel{min-height:84svh;justify-content:center}
    .sys-grid{grid-template-columns:1fr;gap:26px}
    .sys-stage{max-width:330px;order:-1}
    .sys-readout{max-height:none}
  }
  @media (max-width:760px){
    .hud{display:none}
    .panel-head .psub{font-size:12.5px}
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto}
    .panel-head,.sys-grid,.sys-foot,.panel.contact-panel{opacity:1!important;transform:none!important;transition:none}
    .ro-in,.rb,.ro-honors span{animation:none}
    .hint::after{animation:none}
  }
</style>
</head>
<body>
<canvas id="studio-canvas" aria-hidden="true"></canvas>

<div class="bar">
  <span class="m id"><span class="sl">//</span> william jin — 3d</span>
  <a class="exit" href="/">Exit</a>
</div>

<section class="scn first">
  <div>
    <div class="m greet">/ 3d mode — flight 002</div>
    <h1>The other site.</h1>
    <p class="sub">One continuous drift through the dust — past the rings, toward the beacon. Three stations on the route: the work as an orrery, the projects as a galaxy, and a way to reach me at the end.</p>
    <p class="m nogl-note">webgl unavailable — static view</p>
  </div>
  <span class="m hint">scroll to drift</span>
</section>

<!-- 01 — EXPERIENCE: the orrery -->
<section class="station" id="st-work">
  <div class="panel" id="sys-work">
    <header class="panel-head">
      <span class="pnum">01</span>
      <div>
        <div class="pttl">Experience</div>
        <p class="psub">Four orbits, four roles — each world circling the work. The amber planet is in focus; tour them, or pick one.</p>
      </div>
    </header>
    <div class="sys-grid">
      <div class="sys-stage" aria-hidden="true"></div>
      <div class="sys-readout" aria-live="polite"></div>
    </div>
    <div class="sys-foot">
      <div class="sys-legend" role="tablist" aria-label="experience"></div>
      <div class="sys-nav"><button class="sys-prev" aria-label="previous">‹</button><span class="sys-count m"></span><button class="sys-next" aria-label="next">›</button></div>
    </div>
  </div>
</section>

<!-- 02 — PROJECTS: the galaxy -->
<section class="station" id="st-proj">
  <div class="panel" id="sys-projects">
    <header class="panel-head">
      <span class="pnum">02</span>
      <div>
        <div class="pttl">Projects</div>
        <p class="psub">A spiral arm of what I've built — the newest rides the frontier, the earliest near the core. The lit star is in focus.</p>
      </div>
    </header>
    <div class="sys-grid">
      <div class="sys-stage" aria-hidden="true"></div>
      <div class="sys-readout" aria-live="polite"></div>
    </div>
    <div class="sys-foot">
      <div class="sys-legend" role="tablist" aria-label="projects"></div>
      <div class="sys-nav"><button class="sys-prev" aria-label="previous">‹</button><span class="sys-count m"></span><button class="sys-next" aria-label="next">›</button></div>
    </div>
  </div>
</section>

<!-- 03 — CONTACT: the beacon -->
<section class="station contact" id="st-contact">
  <div class="panel contact-panel" data-reveal>
    <div class="m c-eyebrow">station 03 · contact</div>
    <h2>You reached the <b>beacon</b>.</h2>
    <p class="c-sub">Second-year software engineering at Waterloo, building agentic systems and the web around them. If any of this resonates, the channel's open.</p>
    <div class="c-links">
      <a class="c-link" href={contact.email}>Email</a>
      <a class="c-link" href={contact.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="c-link" href={contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="c-link" href={contact.devpost} target="_blank" rel="noreferrer">Devpost</a>
    </div>
    <div class="m c-where"><span class="dot"></span>based in Waterloo, ON</div>
  </div>
</section>

<div class="hud" aria-hidden="true"><span>scroll</span><span class="hv" id="hud-scroll">0%</span></div>

<div class="lbox" id="lbox" aria-hidden="true"><i class="lbar top"></i><i class="lbar bot"></i><span class="card" id="lbcard"></span></div>

<div class="shutter" id="shutter" aria-hidden="true"><span class="sedge"></span></div>

<script is:inline type="application/json" id="studio-data" set:html={studioJson}></script>
<script>
  // Bundled modules (Vite tree-shakes three.js). If the renderer can't be
  // constructed, degrade to the static dark page — the content layer still runs.
  import { initDriftScene } from '../scripts/drift-scene';
  import { initStudioContent } from '../scripts/studio-content';
  const c = document.getElementById('studio-canvas');
  if (c instanceof HTMLCanvasElement) {
    try { initDriftScene(c); } catch { document.body.classList.add('no-gl'); }
  } else {
    document.body.classList.add('no-gl');
  }
  initStudioContent();
</script>
<script is:inline>
  const hudScroll=document.getElementById('hud-scroll');
  function updScroll(){const h=document.documentElement;const max=(h.scrollHeight-innerHeight)||1;hudScroll.textContent=Math.round(Math.max(0,Math.min(1,h.scrollTop/max))*100)+'%';}
  addEventListener('scroll',updScroll,{passive:true}); updScroll();

  // mode shutter — reveal on arrival from the paper site; cover on exit
  (()=>{
    const sh=document.getElementById('shutter');
    if(!sh)return;
    const rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!rm && sessionStorage.getItem('wj-transit')==='down'){
      sh.classList.add('reveal');
      sh.addEventListener('animationend',()=>sh.classList.remove('reveal'),{once:true});
    }
    sessionStorage.removeItem('wj-transit');
    const exit=document.querySelector('a.exit');
    if(exit)exit.addEventListener('click',e=>{
      if(rm||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||e.button)return;
      e.preventDefault();
      if(sh.classList.contains('cover'))return;
      sessionStorage.setItem('wj-transit','up');
      sh.classList.add('cover');
      sh.addEventListener('animationend',()=>{location.href=exit.href;},{once:true});
    });
    addEventListener('pageshow',e=>{if(e.persisted)sh.classList.remove('cover','reveal');});
  })();
</script>
</body>
</html>
