    <div class="int-prog"><i id="intbar"></i></div>

    <div class="int-stage">
      <div class="panel" data-i="0">
        <div class="meta"><div class="pidx">01</div><div class="pname">Agentic Applications</div><div class="pdesc">Models that reason, act on tools, and loop on what they observe — not one-shot prompts.</div></div>
        <svg class="dia" viewBox="0 0 320 220">
          <!-- reasoning-core plane (depth) + comet rail -->
          <rect class="plane" data-fade x="46" y="82" width="86" height="56" rx="3"/>
          <path id="react-loop" d="M132 98 C160 82 178 82 206 98 L206 122 C178 138 160 138 132 122 Z" fill="none" stroke="none"/>
          <!-- query in -->
          <circle class="fill" data-pop cx="16" cy="110" r="2.7"/>
          <path data-draw pathLength="1" d="M22 110 H44"/>
          <path class="head" data-fade transform="translate(45 110)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <!-- agent — reasoning core (subject) -->
          <rect data-draw pathLength="1" x="46" y="82" width="86" height="56" rx="3"/>
          <path data-draw pathLength="1" d="M60 98 H112"/>
          <path data-draw pathLength="1" d="M60 108 H120"/>
          <path data-draw pathLength="1" d="M60 118 H102"/>
          <!-- tools (secondary) -->
          <rect class="struct" data-draw pathLength="1" x="206" y="80" width="76" height="60" rx="3"/>
          <circle class="struct" data-draw pathLength="1" cx="226" cy="98" r="7"/>
          <path class="struct" data-draw pathLength="1" d="M231 103 L238 110"/>
          <path class="axis" data-draw pathLength="1" d="M214 113 H274"/>
          <path class="struct" data-draw pathLength="1" d="M226 122 L220 129 L226 136"/>
          <path class="struct" data-draw pathLength="1" d="M240 122 L246 129 L240 136"/>
          <!-- ReAct loop (hero): act -> observe -->
          <path class="amber" data-draw pathLength="1" d="M132 98 C160 82 178 82 206 98"/>
          <path class="head-amber" data-fade transform="translate(206 98) rotate(24)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <path class="amber" data-draw pathLength="1" d="M206 122 C178 138 160 138 132 122"/>
          <path class="head-amber" data-fade transform="translate(132 122) rotate(210)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <!-- final answer out -->
          <path data-draw pathLength="1" d="M89 138 V172"/>
          <path class="head" data-fade transform="translate(89 173) rotate(90)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
