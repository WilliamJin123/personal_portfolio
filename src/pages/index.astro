---
// Landing page — ported from the v14 design mock.
// Self-contained (its own light theme, fonts, and client script) so it does
// NOT inherit the dark scaffold theme from Base.astro / global.css, which
// still back the /work/[slug] project pages.
//   - the global style block is emitted unscoped, verbatim
//   - the inline client script is emitted as-is, not bundled by Vite
import { entries } from '../resume/data/entries';
import { tokenize } from '../resume/tokenize';
import { tokensToHtml } from '../resume/html';
import { parseEndDate, parseStartDate, termOf } from '../resume/data/order';
import { portfolioMedia } from '../data/portfolio-media';

const toView = (e: (typeof entries)[number]) => {
  const m = portfolioMedia[e.id] ?? {};
  return {
    id: e.id,
    title: e.title,
    role: e.role ?? '',
    dateLabel: e.dateLabel,
    location: e.location ?? '',
    subtitle: e.subtitle ?? '',
    links: e.links ?? [],
    bulletsHtml: e.bullets.map((b) => tokensToHtml(tokenize(b.text))),
    awards: e.awards ?? [],
    grants: e.grants ?? [],
    stack: m.stack ?? [],
    images: m.images ?? [],
    footnotes: m.footnotes ?? [],
    when: parseEndDate(e.dateLabel), // end date — intra-term ordering (latest first)
    term: termOf(e.dateLabel), // UWaterloo term (start-based) — drives the timeline grouping
    mon: parseStartDate(e.dateLabel)?.monthLabel ?? '', // start month, shown on the spine (matches the term bucket)
  };
};

// `hidden` (in portfolio-media) trims an entry from the public browser only; it
// stays in the résumé library/pool.
const shown = (e: (typeof entries)[number]) => portfolioMedia[e.id]?.hidden !== true;
const workData = {
  projects: entries.filter((e) => e.section === 'projects' && shown(e)).map(toView),
  work: entries.filter((e) => e.section === 'experience' && shown(e)).map(toView),
};
// Escape every opening angle bracket so the serialized JSON can't terminate
// the script element it is injected into. (split/join, not a regex literal, so
// Vite's esbuild dependency scanner can parse this page.)
const workJson = JSON.stringify(workData).split('<').join('\\u003c');

// Contact links — single source of truth for the header nav + the footer pill.
// External links get target/rel at the call sites; mail uses a mailto: URL.
const links = {
  cv: '#', // TODO: wire to the hosted résumé PDF once it's published
  github: 'https://github.com/WilliamJin123',
  mail: 'mailto:w3jin@uwaterloo.ca',
  linkedin: 'https://www.linkedin.com/in/william-jin-874b572a1',
  devpost: 'https://devpost.com/jinwilliam-jin',
  mode3d: '/3d', // the second site — dark WebGL mode (shell for now)
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#eceef1" />
<title>William Jin — Software Engineer</title>
<meta name="description" content="William Jin — second-year software engineering student at the University of Waterloo. Frontend craft and applied ML." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@300..600&display=swap" />
<style is:global>
  :root{
    --paper:#eceef1; --paper2:#e2e5ea; --ink:#16181c; --ink2:#3f444c; --mute:#6b6f78; --faint:#a6abb3;
    --rule:rgba(20,24,32,.13); --amber:#bd741b; --amber-rgb:189,116,27; --grant:#3a7d5c; --grant-rgb:58,125,92;
    --sans:'Geist',system-ui,sans-serif; --mono:'Geist Mono',ui-monospace,monospace;
    --ease:cubic-bezier(.2,.7,.2,1); /* the house curve — fast attack, soft landing */
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;overflow-x:clip}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  .m{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
  .wrap{width:100%;max-width:1800px;margin:0 auto;padding:0 clamp(28px,3.5vw,68px);position:relative}

  header{padding:26px 0 16px;border-bottom:1px dashed var(--rule)}
  .hd{display:flex;justify-content:space-between;align-items:center}
  .id{display:flex;align-items:center}
  /* wordmark — the name is the mark; one amber full-stop is the only accent
     (restraint over a boxed monogram, which read as template-y). */
  .id .nm{font-family:var(--mono);font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);text-decoration:none;transition:color .3s ease}
  .id .nm .dot{color:var(--amber)}
  .id .nm:hover{color:var(--ink)}

  nav{display:flex;gap:12px}
  .nl{position:relative;display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);text-decoration:none;padding:9px 15px;border-radius:7px}
  .nl .fillbg{position:absolute;inset:0;border-radius:7px;background:var(--amber);transform:scaleY(0);transform-origin:bottom;transition:transform .3s ease;z-index:0}
  .nl:hover .fillbg{transform:scaleY(1);transition-delay:.46s}
  .nl .bd{position:absolute;inset:0;width:100%;height:100%;overflow:visible;z-index:1;pointer-events:none}
  .nl .bd rect{fill:none;stroke:var(--amber);stroke-width:1.4;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .46s ease}
  .nl:hover .bd rect{stroke-dashoffset:0}
  .nl .t{position:relative;z-index:2;transition:color .22s ease}
  .nl:hover .t{color:var(--paper);transition-delay:.52s}
  /* the 3D-mode link beckons: every ~7s an amber node pulses and the border
     traces itself once — a periodic preview of the hover state, so the door
     to the other site reads as a door. Quiet under reduced motion. */
  .nl-3d .t::before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--amber);margin-right:7px;vertical-align:1px;animation:nlDot 7.5s ease-in-out infinite;transition:background .22s ease}
  .nl-3d:hover .t::before{background:var(--paper);transition-delay:.52s;animation:none}
  .nl-3d .bd rect{animation:nlTrace 7.5s ease-in-out infinite}
  .nl-3d:hover .bd rect{animation:none}
  @keyframes nlTrace{0%,74%,96%,100%{stroke-dashoffset:1}82%,88%{stroke-dashoffset:0}}
  @keyframes nlDot{0%,72%,100%{opacity:.45;box-shadow:0 0 0 0 rgba(var(--amber-rgb),0)}80%{opacity:1;box-shadow:0 0 0 4px rgba(var(--amber-rgb),.16)}90%{opacity:1;box-shadow:0 0 0 0 rgba(var(--amber-rgb),0)}}
  @media (prefers-reduced-motion:reduce){.nl-3d .bd rect,.nl-3d .t::before{animation:none}.nl-3d .t::before{opacity:1}}
  /* 3D entry parked while the second site is built: inert + dimmed, no beckon,
     and a little hand-pinned sign that hangs lopsided off the corner. */
  .nl-3d.wip{cursor:default}
  .nl-3d.wip .t{color:var(--mute)}
  .nl-3d.wip .t::before{animation:none;background:var(--mute);opacity:.55;box-shadow:none}
  .nl-3d.wip .bd rect{animation:none;stroke-dashoffset:1}
  .nl-3d.wip:hover .fillbg{transform:scaleY(0)}      /* don't pretend to be a door */
  .nl-3d.wip:hover .bd rect{stroke-dashoffset:1}
  .nl-3d.wip:hover .t,.nl-3d.wip:hover .t::before{color:var(--mute);background:var(--mute)}
  .wip-tag{position:absolute;top:100%;right:6px;margin-top:11px;z-index:6;pointer-events:none;
    font-family:var(--mono);font-size:8.5px;letter-spacing:.12em;color:var(--amber);white-space:nowrap;
    padding:4px 8px 4px 9px;border:1px solid rgba(var(--amber-rgb),.45);border-radius:3px;background:var(--paper);
    box-shadow:0 5px 14px rgba(0,0,0,.16);transform:rotate(-7deg);transform-origin:13px -8px}
  .wip-tag::before{content:"";position:absolute;top:-8px;left:11px;width:5px;height:5px;border-radius:50%;
    background:var(--amber);box-shadow:0 0 0 2.5px var(--paper)}   /* the nail it hangs from */
  .wip-tag::after{content:"";position:absolute;top:-7px;left:13px;width:1px;height:9px;
    background:rgba(var(--amber-rgb),.55);transform:rotate(7deg);transform-origin:top}   /* the thread */
  @media (prefers-reduced-motion:reduce){.wip-tag{transform:rotate(-7deg)}}

  .hero{padding:104px 0 120px}
  /* entrance — the lead copy rises in once on load, line by line (the Will
     blur-in and UWaterloo clip reveal then land on top of this rhythm) */
  @keyframes leadIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
  .lead>*{animation:leadIn .65s var(--ease) backwards}
  .lead>h1{animation-delay:.08s}
  .lead>.role{animation-delay:.17s}
  .lead>.school{animation-delay:.26s}
  h1{font-weight:540;font-size:clamp(44px,5.6vw,82px);line-height:1.04;letter-spacing:-.028em}
  .will{color:var(--amber);filter:blur(11px);opacity:0;display:inline-block;transition:filter .8s ease,opacity .8s ease}
  .will.on{filter:blur(0);opacity:1}
  .role{margin-top:28px;font-size:clamp(22px,2.6vw,32px);font-weight:470;letter-spacing:-.012em}
  .role .mut{color:var(--mute)}
  .school{margin-top:8px;font-size:clamp(22px,2.6vw,32px);font-weight:470;letter-spacing:-.012em;white-space:nowrap}
  .rest{display:inline-block;clip-path:inset(-8% 100% -8% -2%);opacity:0;transition:clip-path .82s cubic-bezier(.7,0,.15,1) .15s,opacity .5s ease .2s}
  .school.on .rest{clip-path:inset(-8% -3% -8% -2%);opacity:1}

  /* interests — single-screen: hairline concept instruments on the left, 3 staggered bullets on the right */
  .interests{position:relative;border-top:1px solid var(--rule);padding:clamp(48px,9vh,96px) 0 clamp(56px,11vh,112px)}
  .int-head{display:flex;justify-content:space-between;align-items:center}
  .int-title{font-size:15px;color:var(--ink);letter-spacing:.14em}
  .int-title .sl{color:var(--amber)}
  .int-grid{margin-top:34px;display:grid;grid-template-columns:1.7fr 1fr;gap:clamp(28px,4vw,64px);align-items:center}
  .int-grid>*{min-width:0}
  .int-vis{position:relative;aspect-ratio:1/1;width:100%;max-width:660px;justify-self:start}
  /* a soft pool of calm under the instrument so the page's background mesh
     recedes behind the hairlines — feathered to transparent, no panel edge */
  .int-vis::before{content:"";position:absolute;inset:-4%;z-index:0;pointer-events:none;
    background:radial-gradient(58% 58% at 50% 50%,var(--paper) 0%,var(--paper) 46%,rgba(236,238,241,0) 78%)}
  /* three hairline instrument diagrams, used now only for their DECORATIONS
     (labels, guides, ornaments). JS fades each .ifig per phase — full while its
     shape is settled, dim during a morph. The actual line is the .spine below,
     which continuously reshapes from one diagram into the next; the original
     spine paths (data-dot) are kept only as invisible sampling sources. */
  .ifig{position:absolute;inset:0;z-index:1;width:100%;height:100%;opacity:0}
  .ifig [data-dot]{stroke:none!important;fill:none!important}
  .ifig *{vector-effect:non-scaling-stroke}
  .ifig .hair{stroke:var(--ink2);stroke-width:1.1;stroke-linejoin:miter;stroke-linecap:square}
  .ifig .faint{stroke:var(--faint);stroke-width:1;stroke-linejoin:miter}
  .ifig .pap{fill:var(--paper)}
  .ifig .ambf{fill:var(--amber)}
  .ifig text{fill:var(--faint);font-family:var(--mono);font-size:12.5px;letter-spacing:.16em;text-transform:uppercase}
  .ifig .tiny{font-size:10px;letter-spacing:.1em}
  .ifig .lk{fill:var(--mute)}
  .ifig .trace,.ifig .g-path{stroke:var(--ink2);stroke-width:1.1;fill:none;opacity:.42;stroke-linejoin:miter}
  .ifig .floor{stroke:var(--faint);stroke-width:1;stroke-dasharray:2 6;opacity:.6}
  .ifig .tool-on{stroke:var(--amber);opacity:.85}
  /* the morphing line + its dot, in one overlay above the decorations. JS
     rebuilds .spine every frame as a point-for-point blend between the three
     diagram shapes — a circle becomes the stack-trace becomes the loss curve and
     back — and the amber dot rides this single, ever-present line. */
  .idot{position:absolute;inset:0;z-index:3;width:100%;height:100%;pointer-events:none}
  .spine{fill:none;stroke:var(--ink2);stroke-width:1.2;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke;opacity:0;transition:opacity .6s ease}
  .int-vis.dot-on .spine{opacity:.72}
  .idot-c{fill:var(--amber);opacity:0;filter:drop-shadow(0 0 5px rgba(var(--amber-rgb),.55));transition:opacity .9s ease}
  .int-vis.dot-on .idot-c{opacity:.95}
  .int-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:clamp(36px,5.5vh,64px)}
  .int-item{display:flex;align-items:flex-start;gap:18px;will-change:transform,opacity}
  .int-num{flex-shrink:0;font-size:11px;letter-spacing:.14em;color:var(--faint);padding-top:6px;transition:color .45s ease}
  .int-row{display:flex;flex-direction:column;gap:7px;min-width:0}
  .int-name{font-size:clamp(20px,2.4vw,28px);font-weight:540;letter-spacing:-.02em;line-height:1.1;color:var(--ink);transition:color .45s ease}
  /* the list mirrors the canvas: the figure on stage carries .live (set by the
     interests-graph script) — amber index, ink name, full underline drawing in;
     off-stage rows recede to faint. Gated on :has(.live) so a no-JS page (no
     .live anywhere) keeps every row at full strength. NOTE: dim via color, not
     opacity — the scroll-reveal loop writes inline opacity on .int-item. */
  .int-name::after{content:"";display:block;height:1.5px;width:0;background:var(--amber);margin-top:7px;transition:width .6s cubic-bezier(.2,.7,.2,1)}
  .int-list:has(.live) .int-item:not(.live) .int-name{color:var(--faint)}
  .int-item.live .int-num{color:var(--amber)}
  .int-item.live .int-name::after{width:100%}

  .stack{padding:60px 0 14px;border-top:1px solid var(--rule)}
  .stack-head{display:flex;align-items:center;gap:20px;margin-bottom:18px;flex-wrap:wrap}
  .legend{display:flex;gap:6px;flex-wrap:wrap}
  .lg{font-family:var(--mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--faint);background:none;border:1px solid transparent;border-radius:999px;padding:5px 12px;cursor:pointer;transition:color .35s,border-color .35s,background .35s}
  .lg:hover{color:var(--mute)}
  .lg.active{color:var(--ink);border-color:var(--rule);background:var(--paper)}
  .lg.active::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--amber);margin-right:8px;vertical-align:middle}
  .hint{color:var(--faint);text-transform:none;letter-spacing:.04em;margin-left:auto}
  .drum-win{height:210px;position:relative;perspective:900px;overflow:hidden}
  .drum-win::before,.drum-win::after{content:"";position:absolute;left:0;right:0;height:1px;background:var(--rule);z-index:5;transition:background .3s}
  .drum-win::before{top:50%;margin-top:-35px}
  .drum-win::after{top:50%;margin-top:35px}
  .drum-win:hover::before,.drum-win:hover::after{background:var(--amber)}
  /* push the cylinder back by its radius (R=150 in the drum script) so the front
     slide lands flat at z=0 — without this it sits at +R and the perspective
     magnifies it, shoving the left-anchored category label off the edge */
  .drum{position:absolute;inset:0;transform-style:preserve-3d;transform:translateZ(-150px)}
  .slide{position:absolute;left:0;right:0;height:70px;top:50%;margin-top:-35px;transform-origin:center center;backface-visibility:hidden;display:flex;align-items:center;gap:40px}
  .slide .cat{display:flex;flex-direction:column;gap:6px;width:140px;flex-shrink:0;border-left:1px solid var(--rule);padding-left:16px}
  .slide .cat .ci{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;color:var(--faint)}
  .slide .cat .cn{position:relative;font-family:var(--mono);font-size:16px;letter-spacing:.02em;color:#42474f;text-transform:uppercase}
  /* subtle amber accent — a short underline that periodically breathes */
  .slide .cat .cn::after{content:"";position:absolute;left:0;bottom:-5px;height:2px;width:14px;background:var(--amber);border-radius:1px;animation:catPulse 3.6s ease-in-out infinite}
  @keyframes catPulse{0%,100%{opacity:.3;width:13px}50%{opacity:.92;width:23px}}
  @media (prefers-reduced-motion:reduce){.slide .cat .cn::after{animation:none;opacity:.6}}
  .chips{display:flex;flex-wrap:nowrap;gap:10px;min-width:0;padding:6px 0;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;user-select:none;-webkit-mask-image:linear-gradient(to right,transparent 0,#000 var(--cl,0px),#000 calc(100% - var(--cr,0px)),transparent 100%);mask-image:linear-gradient(to right,transparent 0,#000 var(--cl,0px),#000 calc(100% - var(--cr,0px)),transparent 100%)}
  .chips::-webkit-scrollbar{display:none}
  .chips span{font-family:var(--mono);font-size:13.5px;border:1px solid var(--rule);border-radius:999px;padding:8px 15px;color:var(--ink);background:var(--paper);display:flex;align-items:center;gap:9px;white-space:nowrap;transition:border-color .2s,background .2s,transform .2s}
  .chips span .ic{width:16px;height:16px;flex-shrink:0;background:var(--ink);-webkit-mask:var(--i) center/contain no-repeat;mask:var(--i) center/contain no-repeat;transition:background .2s}
  .chips span:hover{border-color:var(--amber);background:var(--paper2);transform:translateY(-2px)}
  .chips span:hover .ic{background:var(--amber)}

  /* work experience + projects — chronological timeline with a big sticky
     title at its left so the section announces itself. */
  .work{padding:60px 0 110px;border-top:1px solid var(--rule)}
  /* symmetric 3-col grid: an empty mirror column on the right balances the title
     on the left, so the timeline sits dead-centre on the page; it shrinks below
     780 on narrower screens, then the rule below stacks it. */
  .work-body{display:grid;grid-template-columns:240px minmax(0,780px) 240px;gap:0 clamp(18px,2.4vw,34px);justify-content:center;align-items:start}
  .work-side{grid-column:1;justify-self:end}
  .work-side .in{position:sticky;top:110px;padding-top:8px}
  .wtl{grid-column:2}
  .wt{font-size:clamp(28px,3.3vw,42px);font-weight:600;letter-spacing:-.022em;line-height:1.12;color:var(--ink)}
  .wt .l{display:block}
  .wt .sl,.wt .plus{color:var(--amber)}
  @media (max-width:1024px){
    .work-body{display:block}
    .work-side{justify-self:auto}
    .work-side .in{position:static;margin-bottom:26px}
    .wt .l{display:inline}
    .wt{font-size:clamp(28px,6vw,40px)}
  }

  .wd-links{margin-top:14px;display:flex;flex-wrap:wrap;gap:18px}
  .wd-link{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase}
  .rbul{list-style:none;margin:18px 0 0;padding:0}
  .rbullet{position:relative;font-size:14px;line-height:1.6;color:var(--ink);margin-bottom:13px;padding-left:16px}
  .rbullet::before{content:"–";position:absolute;left:0;color:var(--mute)}
  .rbold{display:inline-block;font-weight:680;color:var(--ink)}
  .rlink{color:var(--ink);text-decoration:none;background:linear-gradient(var(--amber),var(--amber)) left bottom/100% 1.6px no-repeat;padding-bottom:1px}
  .rlink:hover{color:var(--amber)}
  .wd-stack{margin-top:20px;display:flex;flex-wrap:wrap;gap:9px}
  .wd-stack span{flex-shrink:0;font-family:var(--mono);font-size:12px;border:1px solid var(--rule);border-radius:999px;padding:6px 12px;color:var(--ink);background:var(--paper);display:flex;align-items:center;gap:8px;white-space:nowrap;transition:border-color .2s,background .2s,transform .2s}
  .wd-stack span:hover{border-color:var(--amber);background:var(--paper2);transform:translateY(-2px)}
  .wd-stack span .ic{width:14px;height:14px;flex-shrink:0;background:var(--ink);-webkit-mask:var(--i) center/contain no-repeat;mask:var(--i) center/contain no-repeat;transition:background .2s}
  .wd-stack span:hover .ic{background:var(--amber)}
  .wd-awards{margin-top:12px;display:flex;flex-wrap:wrap;gap:8px}
  .award,.grant{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;letter-spacing:.03em;border-radius:999px;padding:6px 12px 6px 11px;white-space:nowrap}
  .award{color:var(--amber);background:rgba(var(--amber-rgb),.08);border:1px solid rgba(var(--amber-rgb),.42);--glow:var(--amber-rgb)}
  .grant{color:var(--grant);background:rgba(var(--grant-rgb),.08);border:1px solid rgba(var(--grant-rgb),.42);--glow:var(--grant-rgb)}
  .award svg,.grant svg{width:13px;height:13px;flex-shrink:0}
  @keyframes rBadge{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

  @keyframes rRise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  @keyframes rBold{0%{color:var(--mute);transform:scale(.97)}55%{transform:scale(1.035)}100%{color:var(--ink);transform:scale(1)}}
  @keyframes rUl{from{background-size:0 1.6px}to{background-size:100% 1.6px}}

  /* timeline — a centered, dated spine. Each entry expands its detail in
     place (multiple can be open at once; the first is open by default). */
  .wtl{max-width:780px;margin:0 auto}
  .tl-yr{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);padding-left:112px;margin:22px 0 6px}
  .tl-yr:first-child{margin-top:0}
  .tl-term{color:var(--ink2)}
  .tl-row{position:relative;display:grid;grid-template-columns:112px 1fr}
  .tl-row::before{content:"";position:absolute;left:96px;top:0;bottom:0;width:1px;background:var(--rule)}
  .tl-row:last-child::before{bottom:auto;height:26px}
  .tl-mark{grid-column:1;grid-row:1;position:relative;display:flex;align-items:center;gap:8px;padding:12px 24px 0 0}
  .tl-mon{font-family:var(--mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);margin-left:auto}
  .tl-kind{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);background:rgba(var(--amber-rgb),.08);border:1px solid rgba(var(--amber-rgb),.42);border-radius:999px;padding:3px 9px}
  .tl-dot{position:absolute;left:91.5px;top:18px;width:9px;height:9px;border-radius:50%;background:var(--paper);border:1.6px solid var(--mute);box-sizing:border-box;z-index:1;transition:border-color .3s,background .3s,transform .3s}
  .tl-row.is-role .tl-dot{border-radius:2px}
  .tl-row:hover .tl-dot{border-color:var(--amber)}
  .tl-row.open .tl-dot{border-color:var(--amber);background:var(--amber);transform:scale(1.15)}
  .tl-head{grid-column:2;grid-row:1;text-align:left;background:none;border:0;border-bottom:1px dashed var(--rule);padding:14px 2px 14px 0;cursor:pointer;display:flex;flex-wrap:wrap;align-items:baseline;gap:11px;color:var(--ink2);transition:color .3s}
  .tl-head:hover,.tl-row.open .tl-head{color:var(--ink)}
  .tl-title{font-size:clamp(16px,1.8vw,19px);font-weight:530;letter-spacing:-.015em}
  .tl-badge{width:19px;height:19px;padding:0;gap:0;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;align-self:center;box-sizing:border-box}
  .tl-badge svg{width:11px;height:11px}
  .tl-badge.award{color:var(--amber);background:rgba(var(--amber-rgb),.08);border:1px solid rgba(var(--amber-rgb),.42)}
  .tl-badge.grant{color:var(--grant);background:rgba(var(--grant-rgb),.08);border:1px solid rgba(var(--grant-rgb),.42)}
  .tl-hmeta{font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}
  .tl-chev{margin-left:auto;align-self:center;flex-shrink:0;width:8px;height:8px;border-right:1.5px solid var(--mute);border-bottom:1.5px solid var(--mute);transform:rotate(45deg);transition:transform .36s cubic-bezier(.6,0,.2,1),border-color .3s}
  .tl-row.open .tl-chev{transform:rotate(-135deg);border-color:var(--amber)}
  .tl-detail{grid-column:2;grid-row:2;display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .36s cubic-bezier(.6,0,.2,1),opacity .3s ease}
  .tl-row.open .tl-detail{grid-template-rows:1fr;opacity:1}
  .tld-in{overflow:hidden;min-height:0;padding-bottom:18px}
  .tl-detail .rbul{margin-top:11px}
  .tl-detail .wd-stack{margin-top:16px}
  /* open animation — stagger the detail in as a row expands (reuses the List keyframes) */
  .tl-row.open .award,.tl-row.open .grant{animation:rBadge .4s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(.1s + var(--ai)*.07s)}
  .tl-row.open .rbullet{animation:rRise .42s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(.1s + var(--bi)*.06s)}
  .tl-row.open .rbold{animation:rBold .45s ease backwards;animation-delay:calc(.55s + var(--bi)*.06s)}
  .tl-row.open .rlink{animation:rUl .4s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(.2s + var(--bi)*.06s)}
  /* scroll reveal — each row rises in as it scrolls into view (esp. the long mobile stream) */
  .wtl.reveal .tl-row,.wtl.reveal .tl-yr{opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .6s var(--ease)}
  .wtl.reveal .tl-row.seen,.wtl.reveal .tl-yr.seen{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){
    .wtl.reveal .tl-row,.wtl.reveal .tl-yr{opacity:1;transform:none;transition:none}
    .tl-row.open .award,.tl-row.open .grant,.tl-row.open .rbullet,.tl-row.open .rbold,.tl-row.open .rlink{animation:none}
    .lead>*{animation:none}
    .will{filter:none;opacity:1;transition:none}
    .rest{clip-path:none;opacity:1;transition:none}
  }
  [hidden]{display:none!important}

  footer{padding:48px 0 78px;display:flex;flex-direction:column;align-items:center;gap:16px}
  .cta-line{font-size:13px}
  .pill{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--ink);border-radius:999px;padding:6px}
  .pill a{font-family:var(--mono);font-size:clamp(10px,2.7vw,12px);letter-spacing:.07em;text-transform:uppercase;white-space:nowrap;padding:clamp(8px,2.4vw,11px) clamp(12px,3.8vw,20px);border-radius:999px;text-decoration:none;color:var(--ink);transition:background .25s,color .25s,transform .25s,box-shadow .25s}
  .pill a:hover{background:var(--paper2)}
  .pill a.mega{background:var(--amber);color:#fff;font-size:clamp(11px,2.9vw,13px);padding:clamp(10px,2.8vw,14px) clamp(15px,4.6vw,26px)}
  /* primary CTA: keep the amber, lift + amber glow on hover (matches the chip/stack lift) — never grays out */
  .pill a.mega:hover{background:var(--amber);color:#fff;transform:translateY(-2px);box-shadow:0 6px 18px rgba(var(--amber-rgb),.32)}

  /* flair — instrument readout (live telemetry, bottom-left) */
  .hud{position:fixed;left:18px;bottom:15px;z-index:40;font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--faint);text-transform:uppercase;pointer-events:none;display:flex;flex-direction:column;gap:3px;mix-blend-mode:multiply}
  .hud-row{display:flex;gap:8px;align-items:baseline}
  .hud .hk{opacity:.6;min-width:50px}
  .hud .hv{color:var(--mute)}
  .hud .dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--amber);margin-right:5px;vertical-align:middle;animation:blink 2.4s ease-in-out infinite}
  @keyframes blink{0%,100%{opacity:.35}50%{opacity:1}}

  /* flair — viewport instrument: viewfinder corners, crosshair cursor */
  /* ambient site-wide background canvas — fixed full-viewport, behind everything */
  #bg-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none;contain:strict}
  /* mode shutter — the trip to/from /3d. Cover: a dark panel descends over
     the page (dropping into the dark site), amber hairline leading. Reveal
     (arriving back): a paper panel — invisible on paper — slides up and off,
     so all you see is the amber edge scanning up as the page prints in. */
  .shutter{position:fixed;left:0;top:-2vh;width:100%;height:104vh;z-index:200;pointer-events:none;visibility:hidden}
  .shutter .sedge{position:absolute;left:0;bottom:-1px;width:100%;height:2px;background:var(--amber);box-shadow:0 0 18px rgba(var(--amber-rgb),.6)}
  .shutter.cover{visibility:visible;background:#0b0c0e;transform:translateY(-103%);animation:shCover .5s cubic-bezier(.76,0,.24,1) forwards}
  .shutter.reveal{visibility:visible;background:var(--paper);transform:translateY(0);animation:shReveal .6s cubic-bezier(.7,0,.22,1) .06s both}
  @keyframes shCover{to{transform:translateY(0)}}
  @keyframes shReveal{to{transform:translateY(-103%)}}
  .frame{position:fixed;inset:0;z-index:35;pointer-events:none}
  .frame .cnr{position:absolute;width:13px;height:13px;border:1px solid var(--faint);opacity:.55}
  .frame .tl{top:13px;left:13px;border-right:0;border-bottom:0}
  .frame .tr{top:13px;right:13px;border-left:0;border-bottom:0}
  .frame .bl{bottom:13px;left:13px;border-right:0;border-top:0}
  .frame .br{bottom:13px;right:13px;border-left:0;border-top:0}
  .cur{display:none}
  @media (pointer:fine){
    *{cursor:none!important}
    .cur{display:block;position:fixed;top:0;left:0;z-index:60;pointer-events:none;will-change:transform}
    .cur .ch{position:absolute;background:var(--ink);transition:opacity .2s ease}
    .cur .ch-x{left:-9px;top:-.5px;width:18px;height:1px}
    .cur .ch-y{top:-9px;left:-.5px;width:1px;height:18px}
    .cur .pt{position:absolute;left:-1.5px;top:-1.5px;width:3px;height:3px;border-radius:50%;background:var(--ink);transition:background .2s ease}
    .cur .ring{position:absolute;left:-17px;top:-17px;width:34px;height:34px;border:1px solid var(--amber);border-radius:9px;transform:scale(0);opacity:0;transition:transform .26s cubic-bezier(.2,.8,.2,1),opacity .2s ease}
    .cur.lock .ch{opacity:0}
    .cur.lock .pt{background:var(--amber)}
    .cur.lock .ring{transform:scale(1);opacity:1}
  }

  /* ── responsive: tablets & phones ───────────────────────── */
  @media (max-width:760px){
    /* header — let the nav wrap, tighten the links */
    .hd{flex-wrap:wrap;gap:14px}
    nav{gap:8px;flex-wrap:wrap}
    .nl{padding:8px 11px;font-size:10px}

    /* hero */
    .hero{padding:48px 0 64px}
    h1{font-size:clamp(38px,11vw,60px)}
    .role,.school{font-size:clamp(20px,5.8vw,28px)}

    /* interests — stack canvas above bullets */
    .interests{padding:48px 0 64px}
    .int-head{flex-wrap:wrap;gap:6px}
    .int-title{font-size:13px;letter-spacing:.1em}
    .int-grid{grid-template-columns:1fr;gap:30px;margin-top:24px}
    .int-vis{max-width:340px;justify-self:center}
    .int-name{font-size:clamp(20px,5.4vw,24px)}

    /* stack — retire the 3D drum for a clean static list */
    .stack-head .hint{display:none}
    .drum-win{height:auto;overflow:visible;perspective:none}
    .drum-win::before,.drum-win::after{display:none}
    .drum{position:static;transform:none!important;transform-style:flat;display:flex;flex-direction:column;gap:20px}
    .slide{position:static;height:auto;margin:0;transform:none!important;opacity:1!important;flex-direction:column;align-items:flex-start;gap:11px;min-width:0}
    .slide .cat{flex-direction:row;align-items:baseline;gap:10px;width:auto;border-left:0;border-top:2px solid var(--amber);padding:9px 0 0}
    .chips{flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;scrollbar-width:none}
    .chips::-webkit-scrollbar{display:none}
    .chips span{flex-shrink:0}

    /* footer — let the contact pill wrap */
    .pill{flex-wrap:nowrap;justify-content:center}

    /* timeline — tighten the date gutter on small screens */
    .tl-row{grid-template-columns:66px 1fr}
    .tl-row::before{left:55px}
    .tl-dot{left:50.5px}
    .tl-mark{flex-direction:column;align-items:flex-end;gap:6px;padding:16px 18px 0 0}
    .tl-yr{padding-left:66px}
    .tl-kind{font-size:8.5px;letter-spacing:.1em;padding:2px 7px}
    .tl-title{font-size:16px}

    /* drop the fixed telemetry HUD on small screens */
    .hud{display:none}
  }
</style>
</head>
<body>
<canvas id="bg-canvas" aria-hidden="true"></canvas>

<div class="wrap">
  <header>
    <div class="hd">
      <div class="id">
        <a class="nm" href="/" aria-label="William Jin — home">William Jin<span class="dot">.</span></a>
      </div>
      <nav>
        <a class="nl" href={links.cv}><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">CV</span></a>
        <a class="nl" href={links.github} target="_blank" rel="noreferrer"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">GitHub</span></a>
        <a class="nl" href={links.mail}><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">Mail</span></a>
        <a class="nl" href={links.linkedin} target="_blank" rel="noreferrer"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">LinkedIn</span></a>
        <a class="nl" href={links.devpost} target="_blank" rel="noreferrer"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">Devpost</span></a>
        <span class="nl nl-3d wip" role="link" aria-disabled="true" aria-label="Enter 3D — in progress"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">Enter 3D</span><span class="wip-tag">in progress</span></span>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="lead" data-par="0.05" data-reveal>
      <h1>Hi, I'm <span class="will" id="will">Will</span>.</h1>
      <div class="role">Software Engineer<span class="mut"> · 2nd year</span></div>
      <div class="school" id="school">UW<span class="rest">aterloo</span></div>
    </div>
  </section>
</div>

<section class="interests" id="interests">
  <div class="wrap">
    <div class="int-head"><span class="m int-title"><span class="sl">//</span> I'm interested in</span></div>
    <div class="int-grid">
      <div class="int-vis" aria-hidden="true">

        <!-- 01 AGENTIC · the loop. An LLM core runs reason → act → observe in
             order (stations numbered); on "act" it calls the active (amber) tool
             and reads its result back, then loops. -->
        <svg class="ifig" data-fig="0" viewBox="0 0 600 600" fill="none" preserveAspectRatio="xMidYMid meet">
          <!-- tool rack — callable tools as little cards, each with a signature
               line; the active one (amber) is the call in flight. -->
          <text class="lbl" x="487" y="296" text-anchor="middle">tools</text>
          <rect class="hair pap" x="470" y="306" width="34" height="22" rx="3"/>
          <line class="faint" x1="477" y1="314" x2="497" y2="314"/>
          <line class="faint" x1="477" y1="320" x2="490" y2="320"/>
          <rect class="hair tool-on pap" x="470" y="338" width="34" height="22" rx="3"/>
          <line class="tool-on" x1="477" y1="346" x2="497" y2="346"/>
          <line class="tool-on" x1="477" y1="352" x2="490" y2="352"/>
          <rect class="hair pap" x="470" y="370" width="34" height="22" rx="3"/>
          <line class="faint" x1="477" y1="378" x2="497" y2="378"/>
          <line class="faint" x1="477" y1="384" x2="490" y2="384"/>
          <!-- act calls the active tool (amber, out) and reads the result (faint, back) -->
          <path class="tool-on" d="M 419 344 L 465 344"/>
          <path class="tool-on" d="M 465 344 L 458 341 M 465 344 L 458 347"/>
          <path class="faint" d="M 466 354 L 422 354"/>
          <path class="faint" d="M 422 354 L 429 351 M 422 354 L 429 357"/>
          <!-- the cycle + its flow arrows -->
          <path class="hair" data-dot="0" d="M 300 157 A 128 128 0 1 1 299.99 157 Z"/>
          <path class="hair arrow" transform="translate(410.9 221) rotate(60)" d="M -8 -6 L 1 0 L -8 6"/>
          <path class="hair arrow" transform="translate(300 413) rotate(180)" d="M -8 -6 L 1 0 L -8 6"/>
          <path class="hair arrow" transform="translate(189.1 221) rotate(-60)" d="M -8 -6 L 1 0 L -8 6"/>
          <!-- the LLM core the loop runs on -->
          <rect class="hair pap" x="258" y="261" width="84" height="48" rx="7"/>
          <text class="lbl lk" x="300" y="290" text-anchor="middle">LLM</text>
          <!-- stations, numbered in flow order -->
          <circle class="hair pap" cx="300" cy="157" r="6"/>
          <circle class="hair pap" cx="410.9" cy="349" r="6"/>
          <circle class="hair pap" cx="189.1" cy="349" r="6"/>
          <text class="lbl lk" x="300" y="138" text-anchor="middle"><tspan fill="var(--amber)">1</tspan> reason</text>
          <text class="lbl lk" x="410.9" y="376" text-anchor="middle"><tspan fill="var(--amber)">2</tspan> act</text>
          <text class="lbl lk" x="189.1" y="376" text-anchor="middle"><tspan fill="var(--amber)">3</tspan> observe</text>
        </svg>

        <!-- 02 FULL STACK · the tiers. Three stacked layers — client, server,
             database — with the request descending the left rail through every
             tier to the store, then the response rising the right rail back to the
             client. The rails meet across the store (the path's arc-length midpoint),
             so it lands on the circle's bottom / the loss minimum under a morph. -->
        <svg class="ifig" data-fig="1" viewBox="0 0 600 600" fill="none" preserveAspectRatio="xMidYMid meet">
          <!-- the three tiers: two slabs over a database -->
          <rect class="hair pap" x="168" y="96" width="264" height="78" rx="7"/>
          <rect class="hair pap" x="168" y="240" width="264" height="78" rx="7"/>
          <ellipse class="hair pap" cx="300" cy="398" rx="64" ry="15"/>
          <path class="hair pap" d="M 236 398 L 236 460 A 64 15 0 0 0 364 460 L 364 398"/>
          <text class="lbl" x="192" y="141">client</text>
          <text class="lbl" x="192" y="285">server</text>
          <text class="lbl" x="300" y="495" text-anchor="middle">database</text>
          <!-- request down the left rail, response up the right rail. Path runs
               res-end → req-end so the dot (which sweeps u:1→0, kept that way so
               the morph seams hold) rides it FORWARD: req down, across, res up. -->
          <path class="trace" data-dot="1" d="M 364 66 L 364 430 L 236 430 L 236 66"/>
          <path class="hair arrow" transform="translate(236 206) rotate(90)" d="M -7 -5 L 1 0 L -7 5"/>
          <path class="hair arrow" transform="translate(364 206) rotate(-90)" d="M -7 -5 L 1 0 L -7 5"/>
          <text class="lbl lk" x="236" y="54" text-anchor="middle">req</text>
          <text class="lbl lk" x="364" y="54" text-anchor="middle">res</text>
        </svg>

        <!-- 03 MACHINE LEARNING · the descent. Training loss falls epoch by epoch
             (the step nodes ride the curve) toward its irreducible minimum. -->
        <svg class="ifig" data-fig="2" viewBox="0 0 600 600" fill="none" preserveAspectRatio="xMidYMid meet">
          <path class="faint" d="M 72 88 L 72 540 L 540 540" opacity=".8"/>
          <text class="lbl" x="86" y="104">loss</text>
          <text class="lbl tiny" x="528" y="562" text-anchor="end">epochs</text>
          <!-- irreducible-loss floor -->
          <line class="floor" x1="104" y1="470" x2="528" y2="470"/>
          <text class="lbl tiny lk" x="528" y="487" text-anchor="end">min</text>
          <!-- gradient-descent step nodes — they sit on the curve (its own sample
               points), so they ride exactly on the spine when this shape is settled -->
          <circle class="hair pap" cx="130.3" cy="200.1" r="3.6"/>
          <circle class="hair pap" cx="174" cy="284.5" r="3.6"/>
          <circle class="hair pap" cx="226.5" cy="351.7" r="3.6"/>
          <circle class="hair pap" cx="296.5" cy="405.1" r="3.6"/>
          <circle class="hair pap" cx="384" cy="439.3" r="3.6"/>
          <circle class="hair pap" cx="480.3" cy="456.6" r="3.6"/>
          <!-- training loss decaying to its minimum; the travelling dot rides it down -->
          <path class="g-path" data-dot="2" d="M104 132 C105.5 136.1 109.9 148.6 112.8 156.4 C115.7 164.3 118.6 171.8 121.5 179.1 C124.4 186.4 127.4 193.4 130.3 200.1 C133.2 206.9 136.1 213.3 139 219.6 C141.9 225.9 144.9 231.9 147.8 237.7 C150.7 243.5 153.6 249.1 156.5 254.5 C159.4 259.9 162.4 265.1 165.3 270.1 C168.2 275.1 171.1 279.9 174 284.5 C176.9 289.1 179.9 293.6 182.8 297.9 C185.7 302.2 188.6 306.3 191.5 310.3 C194.4 314.3 197.4 318.2 200.3 321.9 C203.2 325.6 206.1 329.2 209 332.6 C211.9 336 214.9 339.3 217.8 342.5 C220.7 345.7 223.6 348.7 226.5 351.7 C229.4 354.7 232.4 357.6 235.3 360.3 C238.2 363.1 241.1 365.7 244 368.2 C246.9 370.8 249.9 373.2 252.8 375.6 C255.7 378 258.6 380.2 261.5 382.4 C264.4 384.6 267.4 386.7 270.3 388.7 C273.2 390.7 276.1 392.7 279 394.6 C281.9 396.5 284.9 398.3 287.8 400 C290.7 401.8 293.6 403.5 296.5 405.1 C299.4 406.7 302.4 408.3 305.3 409.8 C308.2 411.3 311.1 412.7 314 414.1 C316.9 415.5 319.9 416.9 322.8 418.2 C325.7 419.5 328.6 420.7 331.5 421.9 C334.4 423.1 337.4 424.3 340.3 425.4 C343.2 426.5 346.1 427.6 349 428.6 C351.9 429.6 354.9 430.6 357.8 431.6 C360.7 432.6 363.6 433.5 366.5 434.4 C369.4 435.3 372.4 436.1 375.3 436.9 C378.2 437.7 381.1 438.5 384 439.3 C386.9 440.1 389.9 440.9 392.8 441.6 C395.7 442.3 398.6 443 401.5 443.6 C404.4 444.3 407.4 444.9 410.3 445.5 C413.2 446.1 416.1 446.7 419 447.3 C421.9 447.9 424.9 448.4 427.8 448.9 C430.7 449.4 433.6 449.9 436.5 450.4 C439.4 450.9 442.4 451.4 445.3 451.9 C448.2 452.4 451.1 452.8 454 453.2 C456.9 453.6 459.9 454 462.8 454.4 C465.7 454.8 468.6 455.1 471.5 455.5 C474.4 455.9 477.4 456.3 480.3 456.6 C483.2 456.9 486.1 457.2 489 457.5 C491.9 457.8 494.9 458.1 497.8 458.4 C500.7 458.7 503.6 459 506.5 459.3 C509.4 459.6 512.4 459.8 515.3 460 C518.2 460.3 522.6 460.7 524 460.8"/>
        </svg>

        <!-- the morphing line + its dot. JS rebuilds the .spine each frame as a
             point-for-point blend between the three diagram shapes (circle →
             stack-trace → loss curve → …), so the diagrams literally flow into one
             another; the amber dot rides this single, ever-present line. -->
        <svg class="idot" viewBox="0 0 600 600" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path class="spine" d="M0 0"/>
          <circle class="idot-c" r="5"/>
        </svg>

      </div>
      <ul class="int-list">
        <li class="int-item" data-reveal><span class="int-num m">01</span><span class="int-row"><span class="int-name">Agentic Applications</span></span></li>
        <li class="int-item" data-reveal><span class="int-num m">02</span><span class="int-row"><span class="int-name">Full Stack</span></span></li>
        <li class="int-item" data-reveal><span class="int-num m">03</span><span class="int-row"><span class="int-name">Machine Learning</span></span></li>
      </ul>
    </div>
  </div>
</section>

<div class="wrap">
  <section class="stack" data-par="0.04" data-reveal>
    <div class="stack-head">
