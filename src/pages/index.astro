</div>

<script is:inline type="application/json" id="work-data" set:html={workJson}></script>
<script is:inline>
  const clamp=x=>Math.max(0,Math.min(1,x));

  // hero reveal (replays on scroll back)
  const will=document.getElementById('will'), school=document.getElementById('school');
  let heroShown=false;
  function playHero(){will.classList.remove('on');school.classList.remove('on');void will.offsetWidth;
    setTimeout(()=>will.classList.add('on'),100);setTimeout(()=>school.classList.add('on'),380);}
  new IntersectionObserver(es=>{const e=es[0];
    if(e.intersectionRatio>.55 && !heroShown){heroShown=true;playHero();}
    else if(e.intersectionRatio<.2 && heroShown){heroShown=false;will.classList.remove('on');school.classList.remove('on');}
  },{threshold:[0,.2,.55,1]}).observe(document.querySelector('.lead'));

  // interests — scrubbed one-at-a-time focus (more apparent: slide + draw)
  const interests=document.getElementById('interests');
  const panels=[...document.querySelectorAll('.panel')];
  const n=panels.length, centers=panels.map((_,i)=>i/(n-1));
  const bar=document.getElementById('intbar'), count=document.getElementById('intcount');
  function scrub(){
    const total=interests.offsetHeight-innerHeight;
    const p=total>0?clamp(-interests.getBoundingClientRect().top/total):0;
    bar.style.width=(p*100).toFixed(1)+'%';
    count.textContent=String(Math.min(n-1,Math.round(p*(n-1)))+1).padStart(2,'0')+' / '+String(n).padStart(2,'0');
    panels.forEach((w,i)=>{
      const t=p-centers[i], op=clamp(1-Math.abs(t)/0.42), draw=clamp((t+0.40)/0.40), k=1-op;
      w._foc=op;
      w.style.opacity=op.toFixed(3);
      w.style.transform='translate3d(0,'+(-t*168).toFixed(1)+'px,0)';
      w.style.pointerEvents=op>0.5?'auto':'none';
      const meta=w.children[0], dia=w.children[1];
      meta.style.transform='translate3d('+(-k*36).toFixed(1)+'px,0,0)';
      dia.style.transform='translate3d('+(k*44).toFixed(1)+'px,0,0)';
      w.querySelectorAll('[data-draw]').forEach(pa=>pa.style.strokeDashoffset=(1-draw).toFixed(3));
      w.querySelectorAll('[data-pop]').forEach(d=>{d.style.opacity=draw.toFixed(3);d.style.transform='scale('+(0.45+0.55*draw).toFixed(3)+')';});
      w.querySelectorAll('[data-fade]').forEach(d=>{d.style.opacity=draw.toFixed(3);});
    });
  }

  // combined parallax + scroll-in/scroll-out (subtle)
  const animEls=[...document.querySelectorAll('[data-par],[data-reveal]')];
  function animScroll(){
    const vh=innerHeight, c=vh/2, ramp=vh*0.30;
    animEls.forEach(el=>{
      const r=el.getBoundingClientRect(), center=r.top+r.height/2;
      let ty=0, op=1;
      if(el.hasAttribute('data-par')) ty += -(center-c)*parseFloat(el.dataset.par);
      if(el.hasAttribute('data-reveal')){
        const enter=clamp((vh-r.top)/ramp), exit=clamp(r.bottom/ramp);
        op=Math.min(enter,exit);
        ty += (1-enter)*58 - (1-exit)*58;   // rise in from below + drift up/out at top — reads clearly scrolling down
      }
      el.style.opacity=op.toFixed(3);
      el.style.transform='translate3d(0,'+ty.toFixed(1)+'px,0)';
    });
  }

  // stack drum — highlight tracks the TARGET (direct), spin takes shortest path
  const cells=[...document.getElementById('drum').children];
  const N=cells.length, STEP=27, R=150;
  let pos=0, from=0, to=0, t0=0, dur=900, anim=false, paused=false, active=0;
  const drumwin=document.getElementById('drumwin');
  drumwin.addEventListener('mouseenter',()=>paused=true);
  drumwin.addEventListener('mouseleave',()=>paused=false);
  // mobile: retire the 3D drum (CSS shows a static list); skip its per-frame work
  const narrowMQ=matchMedia('(max-width:760px)');
  let drumMobile=narrowMQ.matches;
  function clearDrumInline(){cells.forEach(c=>{c.style.transform='';c.style.opacity='';c.style.zIndex='';});}
  if(drumMobile) clearDrumInline();
  narrowMQ.addEventListener('change',e=>{drumMobile=e.matches; if(drumMobile) clearDrumInline();});
  const lgBtns=[...document.querySelectorAll('.lg')];
  const setActive=()=>lgBtns.forEach((b,i)=>b.classList.toggle('active',i===active));
  function goTo(idx){
    const cur=((Math.round(pos)%N)+N)%N;
    let delta=((idx-cur)%N+N)%N; if(delta>N/2) delta-=N;   // shortest rotational path
    if(delta!==0){from=pos; to=pos+delta; t0=performance.now(); anim=true;}
    active=idx; setActive();                                // highlight jumps straight to target
  }
  lgBtns.forEach(b=>b.addEventListener('click',()=>goTo(+b.dataset.c)));
  setActive();
  const wr=x=>{x=((x%N)+N)%N; if(x>N/2)x-=N; return x;};
  function drum(){
    cells.forEach((c,i)=>{const off=wr(i-pos),a=off*STEP,ca=Math.cos(a*Math.PI/180);
      c.style.transform='rotateX('+a+'deg) translateZ('+R+'px)';
      c.style.opacity=(0.10+0.90*Math.pow(Math.max(0,ca),3)).toFixed(3);
      c.style.zIndex=Math.round(100*ca);});
  }

  // flair — crosshair cursor (reticle locks onto interactive elements)
  const cur=document.getElementById('cur');
  const curOn=matchMedia('(pointer:fine)').matches;
  let cux=innerWidth/2, cuy=innerHeight/2, ctx=cux, cty=cuy;
  if(curOn){
    addEventListener('pointermove',e=>{ctx=e.clientX;cty=e.clientY;},{passive:true});
    const sel='a,button,.chips span,.lg,.nl,.pill a,.icon-ph,.hero-img';
    addEventListener('pointerover',e=>{if(e.target.closest&&e.target.closest(sel))cur.classList.add('lock');});
    addEventListener('pointerout',e=>{const t=e.target.closest&&e.target.closest(sel);const r=e.relatedTarget&&e.relatedTarget.closest&&e.relatedTarget.closest(sel);if(t&&!r)cur.classList.remove('lock');});
  }

  // idle motion — the concept in motion, gated to the focused panel (calm, reduced-motion aware)
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const comet=document.getElementById('react-comet'), loopP=document.getElementById('react-loop');
  const flow1=document.getElementById('fs-flow1'), flow2=document.getElementById('fs-flow2');
  const roller=document.getElementById('ml-roller'), mlP=document.getElementById('ml-steps');
  let loopLen=0, mlLen=0;
  function idle(now){
    if(reduce) return;
    const t=now/1000;
    const f0=panels[0]._foc||0;
    if(loopP){
      if(f0>0.55){ if(!loopLen) loopLen=loopP.getTotalLength();
        const P=loopP.getPointAtLength(((t*0.30)%1)*loopLen);
        comet.setAttribute('cx',P.x.toFixed(1)); comet.setAttribute('cy',P.y.toFixed(1));
        comet.style.opacity=(clamp((f0-0.55)/0.3)*0.95).toFixed(3);
      } else comet.style.opacity='0';
    }
    const f1=panels[1]._foc||0;
    if(flow1){
      if(f1>0.55){ const ph=(t*0.5)%1, o=clamp((f1-0.55)/0.3);
        flow1.setAttribute('cy',(68+18*clamp(ph/0.40)).toFixed(1));
        flow1.style.opacity=ph<0.40?(o*0.95).toFixed(3):'0';
        flow2.setAttribute('cy',(128+18*clamp((ph-0.42)/0.40)).toFixed(1));
        flow2.style.opacity=(ph>=0.42&&ph<0.82)?(o*0.95).toFixed(3):'0';
      } else { flow1.style.opacity='0'; flow2.style.opacity='0'; }
    }
    const f2=panels[2]._foc||0;
    if(roller){
      if(f2>0.55){ if(!mlLen) mlLen=mlP.getTotalLength();
        const cyc=(t*0.26)%1, o=clamp((f2-0.55)/0.3);
        const edge=Math.min(clamp(cyc/0.06), clamp((0.74-cyc)/0.06));
        const P=mlP.getPointAtLength(clamp(cyc/0.72)*mlLen);
        roller.setAttribute('cx',P.x.toFixed(1)); roller.setAttribute('cy',P.y.toFixed(1));
        roller.style.opacity=(o*edge*0.95).toFixed(3);
      } else roller.style.opacity='0';
    }
  }

  function frame(now){
    if(anim){const k=Math.min(1,(now-t0)/dur);const e=1-Math.pow(1-k,3);pos=from+(to-from)*e;
      if(k>=1){anim=false;pos=((to%N)+N)%N;from=pos;}}
    if(!drumMobile) drum(); scrub(); animScroll(); idle(now);
    if(curOn){cux+=(ctx-cux)*0.4;cuy+=(cty-cuy)*0.4;cur.style.transform='translate('+cux.toFixed(1)+'px,'+cuy.toFixed(1)+'px)';}
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  setInterval(()=>{if(!drumMobile && !anim && !paused){active=(active+1)%N;setActive();from=pos;to=pos+1;t0=performance.now();anim=true;}},2900);

  // selected work — projects / experience master-detail (List-5, placeholders)
  (function(){
    const ICONS={react:'react',typescript:'typescript',firebase:'firebase',swift:'swift',python:'python',pytorch:'pytorch',java:'openjdk',postgresql:'postgresql',docker:'docker',node:'nodedotjs',huggingface:'huggingface'};
    const iconURL=k=>`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${ICONS[k]||k}.svg`;
    const WORK=JSON.parse(document.getElementById('work-data').textContent);
    const seg=document.getElementById('wseg'), segink=document.getElementById('segink');
    const listEl=document.getElementById('wlist'), wcards=document.getElementById('wcards'), wmd=document.getElementById('wmd'), wdetail=document.getElementById('wdetail');
    const nameEl=document.getElementById('wdname'), metaEl=document.getElementById('wdmeta'), subtitleEl=document.getElementById('wdsubtitle'), awardsEl=document.getElementById('wdawards'), bulletsEl=document.getElementById('wdbullets'), linksEl=document.getElementById('wdlinks'), idxEl=document.getElementById('wdidx'), stackEl=document.getElementById('wdstack');
    const gcount=document.getElementById('gcount'), gfoot=document.getElementById('gfoot'), gph=document.getElementById('gph'), gprev=document.getElementById('gprev'), gnext=document.getElementById('gnext');
    const vswitch=document.getElementById('vswitch'), vink=document.getElementById('vswitchink'), workBody=wmd.parentElement;
    let set='projects', sel=0, img=0, view='list';
    const data=()=>WORK[set], pad=x=>String(x).padStart(2,'0');

    const moveInk=()=>{const b=seg.querySelector('.sg.active');if(b){segink.style.left=b.offsetLeft+'px';segink.style.width=b.offsetWidth+'px';}};
    const chips=st=>st.map(it=>{const label=typeof it==='string'?it:it.label,slug=typeof it==='string'?it:it.icon,ic=slug?(slug[0]==='/'?slug:iconURL(slug)):'';return `<span style="--i:url('${ic}')"><span class="ic"></span>${label}</span>`;}).join('');
    const TROPHY='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>';
    const DOLLAR='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>';
    const metaLine=e=>[e.role,e.dateLabel,e.location].filter(Boolean).join(' · ');
    const cardSub=e=>e.subtitle || metaLine(e);
    const renderList=()=>{listEl.innerHTML=data().map((e,i)=>`<button class="witem${i===sel?' active':''}" data-i="${i}"><span class="wbar"></span><span class="wn">${pad(i+1)}</span><span class="wtw"><span class="wt">${e.title}</span><span class="wdate">${e.dateLabel}</span></span></button>`).join('');};
    const renderCards=()=>{wcards.innerHTML=data().map((e,i)=>`<button class="wcard" data-i="${i}"><div class="wc-img"><span class="m">image — tbd</span></div><div class="wc-b"><div class="wc-n">${e.title}</div><div class="wc-s">${cardSub(e)}</div></div></button>`).join('');};
    const paintGallery=()=>{const e=data()[sel],n=e.images.length;gcount.textContent=pad(img+1)+' / '+pad(Math.max(n,1));gfoot.textContent=e.footnotes[img]||'image — optional';gph.textContent=n?('image '+pad(img+1)):'image — tbd';};
    const paint=()=>{const e=data()[sel];idxEl.textContent=pad(sel+1);nameEl.textContent=e.title;metaEl.textContent=metaLine(e);if(e.subtitle){subtitleEl.textContent=e.subtitle;subtitleEl.hidden=false;}else{subtitleEl.hidden=true;}const honors=[...(e.awards||[]).map(a=>['award',TROPHY,a]),...(e.grants||[]).map(g=>['grant',DOLLAR,g])];if(honors.length){awardsEl.innerHTML=honors.map(([c,ic,t],j)=>`<span class="${c}" style="--ai:${j}">${ic}${t}</span>`).join('');awardsEl.hidden=false;}else{awardsEl.hidden=true;}if(e.links&&e.links.length){linksEl.innerHTML=e.links.map((l,j)=>`<a class="wd-link rlink" href="${l.href}" target="_blank" rel="noreferrer" style="--bi:${j}">${l.label} ↗</a>`).join('');linksEl.hidden=false;}else{linksEl.hidden=true;}bulletsEl.innerHTML=e.bulletsHtml.map((h,i)=>`<li class="rbullet" style="--bi:${i}">${h}</li>`).join('');stackEl.innerHTML=chips(e.stack);img=0;paintGallery();};
    const renderDetail=animate=>{paint();if(animate){wdetail.classList.remove('play');void wdetail.offsetWidth;wdetail.classList.add('play');}};
    const select=(i,animate)=>{sel=i;[...listEl.children].forEach((c,j)=>c.classList.toggle('active',j===i));renderDetail(animate);};
    const switchSet=ns=>{if(ns===set)return;set=ns;sel=0;seg.querySelectorAll('.sg').forEach(b=>b.classList.toggle('active',b.dataset.set===ns));moveInk();renderList();renderCards();renderDetail(true);syncHeight();};
    const moveVInk=()=>{const b=vswitch.querySelector('.vopt.active');if(b){vink.style.left=b.offsetLeft+'px';vink.style.width=b.offsetWidth+'px';}};
    // lock the section to the taller (list) view so switching to cards doesn't collapse the bottom
    const syncHeight=()=>{if(view==='list'){workBody.style.minHeight='';workBody.style.minHeight=Math.ceil(wmd.offsetHeight)+'px';}};
    const setView=card=>{
      const next=card?'card':'list'; if(next===view)return;
      const out=view==='card'?wcards:wmd, inc=card?wcards:wmd;
      vswitch.querySelectorAll('.vopt').forEach(b=>b.classList.toggle('active',(b.dataset.view==='card')===card)); moveVInk();
      out.classList.add('vout');
      setTimeout(()=>{out.hidden=true;out.classList.remove('vout');inc.classList.add('vout');inc.hidden=false;syncHeight();requestAnimationFrame(()=>requestAnimationFrame(()=>inc.classList.remove('vout')));},240);
      view=next;
    };

    seg.querySelectorAll('.sg').forEach(b=>b.addEventListener('click',()=>switchSet(b.dataset.set)));
    listEl.addEventListener('click',e=>{const b=e.target.closest('.witem');if(b)select(+b.dataset.i,true);});
    wcards.addEventListener('click',e=>{const b=e.target.closest('.wcard');if(b){select(+b.dataset.i,false);setView(false);}});
    gprev.addEventListener('click',()=>{const e=data()[sel];if(!e.images.length)return;img=(img-1+e.images.length)%e.images.length;paintGallery();});
    gnext.addEventListener('click',()=>{const e=data()[sel];if(!e.images.length)return;img=(img+1)%e.images.length;paintGallery();});
    vswitch.querySelectorAll('.vopt').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view==='card')));

    renderList();renderCards();paint();moveInk();moveVInk();
    addEventListener('resize',()=>{moveInk();moveVInk();syncHeight();});
    if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{moveInk();moveVInk();syncHeight();});
    requestAnimationFrame(()=>requestAnimationFrame(syncHeight));

    let workSeen=false;
    new IntersectionObserver(es=>{es.forEach(en=>{if(en.isIntersecting&&!workSeen){workSeen=true;renderDetail(true);}});},{threshold:.25}).observe(document.getElementById('work'));
  })();

  // flair — instrument readout
  const hudPos=document.getElementById('hud-pos'), hudScroll=document.getElementById('hud-scroll'), hudTime=document.getElementById('hud-time');
  addEventListener('pointermove',e=>{hudPos.textContent=String(Math.round(e.clientX)).padStart(3,'0')+','+String(Math.round(e.clientY)).padStart(3,'0');},{passive:true});
  function updScroll(){const h=document.documentElement;hudScroll.textContent=Math.round(clamp(h.scrollTop/((h.scrollHeight-innerHeight)||1))*100)+'%';}
  addEventListener('scroll',updScroll,{passive:true}); updScroll();
  function updTime(){try{hudTime.textContent=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Toronto',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date());}catch(e){hudTime.textContent='--';}}
  updTime(); setInterval(updTime,1000);
</script>
</body>
</html>
