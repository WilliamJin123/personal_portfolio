        <div class="slide"><div class="cat"><span class="ci">05</span><span class="cn">LLMs / Agents</span></div><div class="chips">
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/openai.svg')"><span class="ic"></span>OpenAI</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/anthropic.svg')"><span class="ic"></span>Anthropic</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/googlegemini.svg')"><span class="ic"></span>Gemini</span>
          <span style="--i:url('/icons/cohere.svg')"><span class="ic"></span>Cohere</span>
          <span style="--i:url('/icons/cerebras.svg')"><span class="ic"></span>Cerebras</span>
          <span style="--i:url('/icons/agno.svg')"><span class="ic"></span>Agno</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/langchain.svg')"><span class="ic"></span>LangChain</span>
          <span style="--i:url('/icons/langsmith.svg')"><span class="ic"></span>LangSmith</span>
