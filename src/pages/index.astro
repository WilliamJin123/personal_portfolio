  </section>
</div>

<section class="interests" id="interests">
  <div class="wrap">
    <div class="int-head"><span class="m int-title"><span class="sl">//</span> I'm interested in</span></div>
    <div class="int-grid">
      <div class="int-vis" aria-hidden="true">

        <!-- 01 AGENTIC · the loop: a 3-phase cycle (reason→act→observe) with an
             amber token orbiting; the act node fires a tool as the token passes,
             and a centre gauge fills as context accrues over each lap. -->
        <svg class="ifig" data-fig="0" viewBox="0 0 600 600" fill="none" preserveAspectRatio="xMidYMid meet">
          <circle class="faint" cx="300" cy="285" r="206" opacity=".4"/>
          <!-- tool stations -->
          <text class="lbl" x="492" y="262" text-anchor="middle">tools</text>
          <path class="faint" d="M 411 349 L 484 341"/>
          <rect class="hair pap" x="476" y="289" width="16" height="16"/>
          <rect class="hair tool-on pap" x="476" y="333" width="16" height="16"/>
          <rect class="hair pap" x="476" y="377" width="16" height="16"/>
          <!-- the cycle -->
          <path class="hair" d="M 300 157 A 128 128 0 1 1 299.99 157 Z"/>
          <path class="hair arrow" transform="translate(410.9 221) rotate(60)" d="M -8 -6 L 1 0 L -8 6"/>
          <path class="hair arrow" transform="translate(300 413) rotate(180)" d="M -8 -6 L 1 0 L -8 6"/>
          <path class="hair arrow" transform="translate(189.1 221) rotate(-60)" d="M -8 -6 L 1 0 L -8 6"/>
          <!-- centre context gauge -->
          <circle class="faint" cx="300" cy="285" r="44" opacity=".55"/>
          <circle class="g-gauge" cx="300" cy="285" r="44" pathLength="100"/>
          <text class="lbl tiny" x="300" y="289" text-anchor="middle">ctx</text>
          <!-- nodes -->
          <circle class="hair pap" cx="300" cy="157" r="6"/>
          <circle class="hair pap" cx="410.9" cy="349" r="6"/>
          <circle class="hair pap" cx="189.1" cy="349" r="6"/>
          <text class="lbl lk" x="300" y="138" text-anchor="middle">reason</text>
          <text class="lbl lk" x="410.9" y="376" text-anchor="middle">act</text>
          <text class="lbl lk" x="189.1" y="376" text-anchor="middle">observe</text>
          <!-- one quiet amber token, slowly orbiting -->
          <circle class="g-token ambf" r="5"/>
        </svg>

        <!-- 02 FULL STACK · the trace: a request steps down through the lanes
             (client→edge→server→data), commits at the store, and the response
             climbs back up to paint a fresh line into the UI card. -->
        <svg class="ifig" data-fig="1" viewBox="0 0 600 600" fill="none" preserveAspectRatio="xMidYMid meet">
          <line class="faint" x1="72" y1="130" x2="528" y2="130"/>
          <line class="faint" x1="72" y1="250" x2="528" y2="250"/>
          <line class="faint" x1="72" y1="370" x2="528" y2="370"/>
          <line class="faint" x1="72" y1="490" x2="528" y2="490"/>
          <text class="lbl" x="72" y="118">client</text>
          <text class="lbl" x="72" y="238">edge</text>
          <text class="lbl" x="72" y="358">server</text>
          <text class="lbl" x="72" y="478">data</text>
          <text class="lbl tiny" x="528" y="118" text-anchor="end">01</text>
          <text class="lbl tiny" x="528" y="238" text-anchor="end">02</text>
          <text class="lbl tiny" x="528" y="358" text-anchor="end">03</text>
          <text class="lbl tiny" x="528" y="478" text-anchor="end">04</text>
          <!-- data store -->
          <ellipse class="hair pap" cx="300" cy="476" rx="26" ry="7.5"/>
          <path class="hair" d="M 274 476 L 274 504 A 26 7.5 0 0 0 326 504 L 326 476"/>
          <!-- UI card the response paints into -->
          <rect class="hair pap" x="406" y="58" width="74" height="48" rx="4"/>
          <line class="faint" x1="416" y1="76" x2="470" y2="76"/>
          <line class="faint" x1="416" y1="90" x2="452" y2="90"/>
          <!-- the trace (static hairline) + one slow amber head -->
          <path class="trace" d="M 150 70 L 150 130 L 230 130 L 230 250 L 300 250 L 300 370 L 360 370 L 360 490 L 300 490 L 440 490 L 440 370 L 440 250 L 440 130 L 440 82"/>
          <circle class="g-head ambf" r="4.4"/>
          <text class="lbl lk" x="150" y="58" text-anchor="middle">req</text>
        </svg>

        <!-- 03 MACHINE LEARNING · the descent: gradient descent steps across a
             loss landscape (nested level-sets) and settles into the minimum. -->
