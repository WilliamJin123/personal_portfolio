---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContextAssembly from '../components/illustrations/ContextAssembly.astro';
import CausalAttention from '../components/illustrations/CausalAttention.astro';
import EverydayCraft from '../components/illustrations/EverydayCraft.astro';
import ProjectPage from '../components/ProjectPage';
import ProjectModal from '../components/ProjectModal';

const all = await getCollection('projects', ({ data }) => !data.draft);

const sortByYearDesc = (a: typeof all[0], b: typeof all[0]) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  return (Number(b.data.year) || 0) - (Number(a.data.year) || 0);
};
const sortedAll = all.sort(sortByYearDesc);

// Pre-render every entry's content for the modal templates.
// Also compute prev / next for in-modal navigation.
const rendered = await Promise.all(
  sortedAll.map(async (entry, i) => {
    const r = await render(entry);
    const prev = i > 0 ? sortedAll[i - 1] : null;
    const next = i < sortedAll.length - 1 ? sortedAll[i + 1] : null;
    return {
      entry,
      Content: r.Content,
      prev: prev ? { slug: prev.id, title: prev.data.title } : null,
      next: next ? { slug: next.id, title: next.data.title } : null
    };
  })
);

const work     = rendered.filter((r) => r.entry.data.type === 'work');
const projects = rendered.filter((r) => r.entry.data.type === 'project');
---
<Base title="[Your Name]">
  <div class="container">
    <!-- Hero -->
    <div class="hero">
      <h1>[Your Name],<br /><em>[role]</em></h1>
      <p class="sub">[ ]</p>
      <div class="actions">
        <a href="/resume.pdf" download>Résumé</a>
        <a href="#currently">Currently</a>
        <a href="#work">Work</a>
        <a href="#projects">Projects</a>
        <a href="mailto:[ ]">Contact</a>
      </div>
    </div>

    <!-- Currently — 3 SVG-led beats, text stripped -->
    <div id="currently" class="section currently">
      <div class="section-h">Currently</div>

      <div class="beat">
        <div class="beat-text">
          <h2 class="beat-title"><em>[ ]</em></h2>
          <p class="beat-body">[ ]</p>
        </div>
        <div class="beat-svg"><ContextAssembly /></div>
      </div>

      <div class="beat beat-reverse">
        <div class="beat-text">
          <h2 class="beat-title"><em>[ ]</em></h2>
          <p class="beat-body">[ ]</p>
        </div>
        <div class="beat-svg"><CausalAttention /></div>
      </div>

      <div class="beat">
        <div class="beat-text">
          <h2 class="beat-title"><em>[ ]</em></h2>
          <p class="beat-body">[ ]</p>
        </div>
        <div class="beat-svg"><EverydayCraft /></div>
      </div>
    </div>

    <!-- Work — cards -->
    <div id="work" class="section">
      <div class="section-h">Work</div>
      <div class="card-grid">
        {work.map(({ entry }, i) => (
          <a class="card" href={`/work/${entry.id}`} data-card-slug={entry.id}>
            <div class="card-head">
              <span>{String(i + 1).padStart(2, '0')}</span>
              <span>{entry.data.year}</span>
            </div>
            <div class="card-title">{entry.data.title}</div>
            <div class="card-desc">{entry.data.role}</div>
            <div class="card-affordance">↗ expand</div>
          </a>
        ))}
      </div>
    </div>

    <!-- Projects — cards -->
    <div id="projects" class="section">
      <div class="section-h">Projects</div>
      <div class="card-grid">
        {projects.map(({ entry }, i) => (
          <a class="card" href={`/work/${entry.id}`} data-card-slug={entry.id}>
            <div class="card-head">
              <span>{String(i + 1).padStart(2, '0')}</span>
              <span>{entry.data.year}</span>
            </div>
            <div class="card-title">{entry.data.title}</div>
            <div class="card-desc">{entry.data.summary}</div>
            <div class="card-affordance">↗ expand</div>
          </a>
        ))}
      </div>
    </div>

    <!-- About -->
    <div id="about" class="section">
      <div class="section-h">About</div>
      <div class="about">
        <div class="about-body">
          <p>[ ]</p>
          <p>[ ]</p>
        </div>
        <div class="about-meta">
          <div><span class="lbl">Email</span><span>[ ]</span></div>
          <div><span class="lbl">GitHub</span><span>[ ]</span></div>
          <div><span class="lbl">Based</span><span>[ ]</span></div>
          <div><span class="lbl">Stack</span><span>[ ]</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden templates: one per entry, cloned by the modal on open. -->
  {rendered.map(({ entry, Content, prev, next }) => (
    <template id={`pc-${entry.id}`}>
      <ProjectPage data={entry.data} prev={prev} next={next}>
        <Content />
      </ProjectPage>
    </template>
  ))}

  <!-- Client island — wires up cards ↔ modal ↔ history. -->
  <ProjectModal client:load />
</Base>

<style>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 96px 80px 140px;
  }

  /* Hero */
  .hero {
    max-width: 620px;
    margin-bottom: 160px;
  }
  h1 {
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.02;
    margin-bottom: 32px;
    animation: paper-rise 0.9s cubic-bezier(.2,.7,.2,1) 0.1s both;
  }
  h1 em { font-style: italic; font-weight: 400; }
  .sub {
    font-size: 19px;
    font-weight: 300;
    font-style: italic;
    max-width: 520px;
    min-height: 1.5em;
    line-height: 1.55;
    color: var(--ink-warm);
    margin-bottom: 48px;
    animation: paper-rise 0.9s cubic-bezier(.2,.7,.2,1) 0.28s both;
  }
  .actions {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    font-family: var(--sans);
    font-size: 14px;
    animation: paper-rise 0.9s cubic-bezier(.2,.7,.2,1) 0.42s both;
  }
  .actions a {
    color: var(--ink);
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    transition: padding-left 0.2s ease;
  }
  .actions a:hover { padding-left: 14px; }

  /* Section shells */
  .section { margin-bottom: 140px; }
  .section-h {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--paper-edge);
    margin-bottom: 48px;
  }

  /* Currently — beats */
  .currently .beat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 80px;
    align-items: center;
    margin-bottom: 120px;
  }
  .currently .beat:last-child { margin-bottom: 0; }
  .beat-reverse .beat-text { order: 2; }
  .beat-reverse .beat-svg  { order: 1; }

  .beat-text { max-width: 460px; }
  .beat-title {
    font-family: var(--serif);
    font-size: clamp(34px, 4.2vw, 48px);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.04;
    color: var(--ink);
    margin-bottom: 20px;
    min-height: 1.04em;
  }
  .beat-title em { font-style: italic; font-weight: 400; }
  .beat-body {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-warm);
    min-height: 1.65em;
  }
  .beat-body strong { color: var(--ink); font-weight: 500; }
  .beat-body em { font-style: italic; }

  .beat-svg {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Cards (Work + Projects) */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .card {
    display: block;
    padding: 24px 24px 56px;
    background: rgba(255, 255, 255, 0.38);
    border: 1px solid var(--paper-edge);
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    position: relative;
    cursor: pointer;
    min-height: 220px;
    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.25s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--ink);
    background: rgba(255, 255, 255, 0.72);
    transform: translateY(-2px);
    outline: none;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
    margin-bottom: 22px;
  }
  .card-title {
    font-family: var(--serif);
    font-size: 28px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.04;
    color: var(--ink);
    margin-bottom: 10px;
    min-height: 1.04em;
  }
  .card-desc {
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--ink-warm);
    line-height: 1.5;
    min-height: 1.5em;
  }
  .card-affordance {
    position: absolute;
    bottom: 20px;
    left: 24px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.1em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }
  .card:hover .card-affordance,
  .card:focus-visible .card-affordance {
    opacity: 1;
    transform: translateY(0);
    color: var(--ink);
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 80px;
    padding-top: 28px;
  }
  .about-body { font-size: 17px; line-height: 1.7; color: var(--ink-warm); }
  .about-body p + p { margin-top: 14px; }
  .about-body p { min-height: 1.7em; }
  .about-body strong { font-weight: 500; color: var(--ink); }
  .about-meta { font-family: var(--mono); font-size: 12px; }
  .about-meta div {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--paper-edge);
  }
  .about-meta .lbl { color: var(--ink-mute); }

  @keyframes paper-rise {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Mobile */
  @media (max-width: 980px) {
    .container { padding: 56px 24px 80px; }
    .hero { margin-bottom: 96px; }
    .currently .beat {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 80px;
    }
    .beat-reverse .beat-text { order: 1; }
    .beat-reverse .beat-svg  { order: 2; }
    .card-grid { grid-template-columns: 1fr; }
    .about { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
