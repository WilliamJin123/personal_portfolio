          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/scikitlearn.svg')"><span class="ic"></span>scikit-learn</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/scipy.svg')"><span class="ic"></span>SciPy</span>
