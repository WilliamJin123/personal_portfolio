          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/greensock.svg')"><span class="ic"></span>GSAP</span>
        </div></div>
        <div class="slide"><div class="cat"><span class="ci">02</span><span class="cn">Backend</span></div><div class="chips">
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/nodedotjs.svg')"><span class="ic"></span>Node</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/postgresql.svg')"><span class="ic"></span>Postgres</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/rust.svg')"><span class="ic"></span>Rust</span>
