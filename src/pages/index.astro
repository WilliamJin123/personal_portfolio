        </div></div>
        <div class="slide"><div class="cat"><span class="ci">07</span><span class="cn">Dev Tools</span></div><div class="chips">
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/git.svg')"><span class="ic"></span>Git</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/linux.svg')"><span class="ic"></span>Linux</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/jupyter.svg')"><span class="ic"></span>Jupyter</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/selenium.svg')"><span class="ic"></span>Selenium</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/ffmpeg.svg')"><span class="ic"></span>FFmpeg</span>
