  </section>

  <footer>
    <div class="cta-line m">// let's talk</div>
    <div class="pill" data-par="0.05" data-reveal>
      <a class="mega" href={links.cv}>Download CV</a>
      <a href={links.mail}>Email</a>
      <a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
