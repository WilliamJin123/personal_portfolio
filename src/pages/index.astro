          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/firebase.svg')"><span class="ic"></span>Firebase</span>
        </div></div>
        <div class="slide"><div class="cat"><span class="ci">04</span><span class="cn">ML / Data</span></div><div class="chips">
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/pytorch.svg')"><span class="ic"></span>PyTorch</span>
