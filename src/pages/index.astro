</div>

<div class="frame" aria-hidden="true"><span class="cnr tl"></span><span class="cnr tr"></span><span class="cnr bl"></span><span class="cnr br"></span></div>
<div class="cur" id="cur" aria-hidden="true"><span class="ch ch-x"></span><span class="ch ch-y"></span><span class="ring"></span><span class="pt"></span></div>

<div class="hud" aria-hidden="true">
  <div class="hud-row"><span class="hk">cursor</span><span class="hv" id="hud-pos">000,000</span></div>
  <div class="hud-row"><span class="hk">scroll</span><span class="hv" id="hud-scroll">0%</span></div>
  <div class="hud-row"><span class="hk">waterloo</span><span class="hv"><span class="dot"></span><span id="hud-time">--:--:--</span></span></div>
</div>

<div class="shutter" id="shutter" aria-hidden="true"><span class="sedge"></span></div>

<script is:inline type="application/json" id="work-data" set:html={workJson}></script>
<script is:inline>
  const clamp=x=>Math.max(0,Math.min(1,x));

  // hero reveal (replays on scroll back)
  const will=document.getElementById('will'), school=document.getElementById('school');
  let heroShown=false;
  function playHero(){will.classList.remove('on');school.classList.remove('on');void will.offsetWidth;
    setTimeout(()=>will.classList.add('on'),100);setTimeout(()=>school.classList.add('on'),380);}
  new IntersectionObserver(es=>{const e=es[0];
    if(e.intersectionRatio>.55 && !heroShown){heroShown=true;playHero();}
    else if(e.intersectionRatio<.2 && heroShown){heroShown=false;will.classList.remove('on');school.classList.remove('on');}
  },{threshold:[0,.2,.55,1]}).observe(document.querySelector('.lead'));


  // combined parallax + scroll-in/scroll-out (subtle). Skipped entirely under
  // reduced motion — scrubbed transforms are exactly what that setting is for.
  const motionOK=!matchMedia('(prefers-reduced-motion: reduce)').matches;
  const animEls=[...document.querySelectorAll('[data-par],[data-reveal]')];
  function animScroll(){
    if(!motionOK) return;
    const vh=innerHeight, c=vh/2, ramp=vh*0.30;
    animEls.forEach(el=>{
      const r=el.getBoundingClientRect(), center=r.top+r.height/2;
      let ty=0, op=1;
      if(el.hasAttribute('data-par')) ty += -(center-c)*parseFloat(el.dataset.par);
      if(el.hasAttribute('data-reveal')){
        const enter=clamp((vh-r.top)/ramp), exit=clamp(r.bottom/ramp);
        op=Math.min(enter,exit);
        ty += (1-enter)*44 - (1-exit)*44;   // rise in from below + drift up/out at top — reads clearly scrolling down
      }
      el.style.opacity=op.toFixed(3);
      el.style.transform='translate3d(0,'+ty.toFixed(1)+'px,0)';
    });
  }

  // stack drum — highlight tracks the TARGET (direct), spin takes shortest path
  const cells=[...document.getElementById('drum').children];
  const N=cells.length, STEP=27, R=150;
  let pos=0, from=0, to=0, t0=0, dur=900, anim=false, paused=false, active=0, holdUntil=0;
  const drumwin=document.getElementById('drumwin');
  drumwin.addEventListener('mouseenter',()=>paused=true);
  drumwin.addEventListener('mouseleave',()=>paused=false);
  // mobile: retire the 3D drum (CSS shows a static list); skip its per-frame work
  const narrowMQ=matchMedia('(max-width:760px)');
  let drumMobile=narrowMQ.matches;
  function clearDrumInline(){cells.forEach(c=>{c.style.transform='';c.style.opacity='';c.style.zIndex='';});}
  if(drumMobile) clearDrumInline();
  narrowMQ.addEventListener('change',e=>{drumMobile=e.matches; if(drumMobile) clearDrumInline();});
  const lgBtns=[...document.querySelectorAll('.lg')];
  const setActive=()=>lgBtns.forEach((b,i)=>b.classList.toggle('active',i===active));
  function goTo(idx){
    const cur=((Math.round(pos)%N)+N)%N;
    let delta=((idx-cur)%N+N)%N; if(delta>N/2) delta-=N;   // shortest rotational path
    if(delta!==0){from=pos; to=Math.round(pos)+delta; t0=performance.now(); anim=true;} // integer target — a mid-animation click can't leave pos fractional
    active=idx; setActive(); holdUntil=performance.now()+5000; // pause auto-cycle for a buffer after any manual nav
  }
  lgBtns.forEach(b=>b.addEventListener('click',()=>goTo(+b.dataset.c)));
  setActive();
  const wr=x=>{x=((x%N)+N)%N; if(x>N/2)x-=N; return x;};
  function drum(){
    cells.forEach((c,i)=>{const off=wr(i-pos),a=off*STEP,ca=Math.cos(a*Math.PI/180);
      c.style.transform='rotateX('+a+'deg) translateZ('+R+'px)';
      c.style.opacity=(0.10+0.90*Math.pow(Math.max(0,ca),3)).toFixed(3);
      c.style.zIndex=Math.round(100*ca);});
  }

  // flair — crosshair cursor (reticle locks onto interactive elements)
  const cur=document.getElementById('cur');
  const curOn=matchMedia('(pointer:fine)').matches;
  let cux=innerWidth/2, cuy=innerHeight/2, ctx=cux, cty=cuy;
  if(curOn){
    addEventListener('pointermove',e=>{ctx=e.clientX;cty=e.clientY;},{passive:true});
    const sel='a,button,.chips span,.lg,.nl,.pill a,.mark,.int-vis';
    addEventListener('pointerover',e=>{if(e.target.closest&&e.target.closest(sel))cur.classList.add('lock');});
    addEventListener('pointerout',e=>{const t=e.target.closest&&e.target.closest(sel);const r=e.relatedTarget&&e.relatedTarget.closest&&e.relatedTarget.closest(sel);if(t&&!r)cur.classList.remove('lock');});
  }


  function frame(now){
    if(anim){const k=Math.min(1,(now-t0)/dur);const e=1-Math.pow(1-k,3);pos=from+(to-from)*e;
      if(k>=1){anim=false;pos=((to%N)+N)%N;from=pos;}}
    if(!drumMobile) drum(); animScroll();
    if(curOn){cux+=(ctx-cux)*0.4;cuy+=(cty-cuy)*0.4;cur.style.transform='translate('+cux.toFixed(1)+'px,'+cuy.toFixed(1)+'px)';}
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  setInterval(()=>{if(motionOK && !drumMobile && !anim && !paused && performance.now()>holdUntil){active=(active+1)%N;setActive();from=pos;to=Math.round(pos)+1;t0=performance.now();anim=true;}},2900);

  // stack chips — per-row horizontal scroll: fade edges appear only where content is hidden; drag-to-scroll on mouse
  const chipRows=[...document.querySelectorAll('.slide .chips')];
  const chipFade=row=>{const max=row.scrollWidth-row.clientWidth;row.style.setProperty('--cl',row.scrollLeft>2?'24px':'0px');row.style.setProperty('--cr',(max>2&&row.scrollLeft<max-2)?'34px':'0px');};
  chipRows.forEach(row=>{
    row.addEventListener('scroll',()=>chipFade(row),{passive:true});
    if(matchMedia('(pointer:fine)').matches){let dn=false,sx=0,sl=0;
      row.addEventListener('pointerdown',e=>{dn=true;sx=e.clientX;sl=row.scrollLeft;});
      addEventListener('pointermove',e=>{if(dn){row.scrollLeft=sl-(e.clientX-sx);}});
      addEventListener('pointerup',()=>{dn=false;});
    }
  });
  const refreshChipFades=()=>chipRows.forEach(chipFade);
  refreshChipFades();
  addEventListener('resize',refreshChipFades);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(refreshChipFades);

  // vertical wheel over the drum steps through categories; horizontal intent falls
  // through to the chip rows. Bound to the drum window, so it only captures while
  // the cursor is over the carousel (page scroll is untouched elsewhere).
  let wheelLock=0;
  drumwin.addEventListener('wheel',e=>{
    if(drumMobile || Math.abs(e.deltaX)>Math.abs(e.deltaY)) return;
    e.preventDefault();
    const now=performance.now();
    if(now<wheelLock){wheelLock=now+150;return;} // inside a flick/momentum burst — swallow & hold the lock
    if(Math.abs(e.deltaY)<4) return;             // ignore jitter
    goTo(((active+(e.deltaY>0?-1:1))+N)%N);       // exactly one category step per gesture
    wheelLock=now+150;
  },{passive:false});

  // selected work — a centered, expand-in-place timeline: one unified
  // chronological stream of all entries (projects + roles).
  (function(){
    const ICONS={react:'react',typescript:'typescript',firebase:'firebase',swift:'swift',python:'python',pytorch:'pytorch',java:'openjdk',postgresql:'postgresql',docker:'docker',node:'nodedotjs',huggingface:'huggingface'};
    const iconURL=k=>`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${ICONS[k]||k}.svg`;
    const WORK=JSON.parse(document.getElementById('work-data').textContent);
    const wtlEl=document.getElementById('wtl');

    const chips=st=>st.map(it=>{const label=typeof it==='string'?it:it.label,slug=typeof it==='string'?it:it.icon,ic=slug?(slug[0]==='/'?slug:iconURL(slug)):'';return `<span style="--i:url('${ic}')"><span class="ic"></span>${label}</span>`;}).join('');
    const TROPHY='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>';
    const DOLLAR='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>';
    const awardsHTML=e=>{const h=[...(e.awards||[]).map(a=>['award',TROPHY,a]),...(e.grants||[]).map(g=>['grant',DOLLAR,g])];return h.length?h.map(([c,ic,t],j)=>`<span class="${c}" style="--ai:${j}">${ic}${t}</span>`).join(''):'';};
    const linksHTML=e=>(e.links&&e.links.length)?e.links.map((l,j)=>`<a class="wd-link rlink" href="${l.href}" target="_blank" rel="noreferrer" style="--bi:${j}">${l.label} ↗</a>`).join(''):'';
    const bulletsHTML=e=>e.bulletsHtml.map((h,i)=>`<li class="rbullet" style="--bi:${i}">${h}</li>`).join('');

    const ALL=[...WORK.projects.map(e=>({e,kind:'project'})),...WORK.work.map(e=>({e,kind:'role'}))].sort((a,b)=>{const ka=a.e.when?a.e.when.year*12+a.e.when.monthIndex:-1e9,kb=b.e.when?b.e.when.year*12+b.e.when.monthIndex:-1e9;return kb-ka;});
    const detailHTML=e=>{const a=awardsHTML(e),lk=linksHTML(e);return `<div class="tld-in">${a?`<div class="wd-awards">${a}</div>`:''}<ul class="rbul">${bulletsHTML(e)}</ul><div class="wd-stack">${chips(e.stack)}</div>${lk?`<div class="wd-links">${lk}</div>`:''}</div>`;};
    const renderTl=()=>{
      let curYear=null,html='';
      ALL.forEach((it,i)=>{const e=it.e,w=e.when,year=w?w.year:null,mon=w?w.monthLabel:'—';
        if(year!==curYear){html+=`<div class="tl-yr">${year!=null?year:''}</div>`;curYear=year;}
        const honor=(e.awards&&e.awards.length)?`<span class="tl-badge award" title="Award">${TROPHY}</span>`:((e.grants&&e.grants.length)?`<span class="tl-badge grant" title="Grant">${DOLLAR}</span>`:'');
        const meta=it.kind==='role'?[e.role,e.dateLabel].filter(Boolean).join(' · '):[e.subtitle,e.dateLabel].filter(Boolean).join(' · ');
        html+=`<div class="tl-row${i===0?' open':''}${it.kind==='role'?' is-role':''}" data-i="${i}"><div class="tl-mark"><i class="tl-dot"></i><span class="tl-mon">${mon}</span>${it.kind==='role'?'<span class="tl-kind">work</span>':''}</div><button class="tl-head" aria-expanded="${i===0}"><span class="tl-title">${e.title}</span>${honor}<span class="tl-hmeta">${meta}</span><span class="tl-chev"></span></button><div class="tl-detail">${detailHTML(e)}</div></div>`;
      });
      wtlEl.innerHTML=html;
    };
    // each row toggles independently — multiple can be open at once (first open by default)
    const openRow=row=>{const on=!row.classList.contains('open');row.classList.toggle('open',on);const h=row.querySelector('.tl-head');if(h)h.setAttribute('aria-expanded',on);};
    wtlEl.addEventListener('click',e=>{const b=e.target.closest('.tl-head');if(b)openRow(b.parentElement);});

    renderTl();
    // scroll-reveal each timeline row/year as it enters view (.reveal added by JS so no-JS still shows content)
    wtlEl.classList.add('reveal');
    const tlIO=new IntersectionObserver(es=>{es.forEach(en=>{if(en.isIntersecting){en.target.classList.add('seen');tlIO.unobserve(en.target);}});},{threshold:.18,rootMargin:'0px 0px -6% 0px'});
    wtlEl.querySelectorAll('.tl-row,.tl-yr').forEach(el=>tlIO.observe(el));
  })();

  // flair — instrument readout
  const hudPos=document.getElementById('hud-pos'), hudScroll=document.getElementById('hud-scroll'), hudTime=document.getElementById('hud-time');
  addEventListener('pointermove',e=>{hudPos.textContent=String(Math.round(e.clientX)).padStart(3,'0')+','+String(Math.round(e.clientY)).padStart(3,'0');},{passive:true});
  function updScroll(){const h=document.documentElement;hudScroll.textContent=Math.round(clamp(h.scrollTop/((h.scrollHeight-innerHeight)||1))*100)+'%';}
  addEventListener('scroll',updScroll,{passive:true}); updScroll();
  function updTime(){try{hudTime.textContent=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Toronto',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date());}catch(e){hudTime.textContent='--';}}
  updTime(); setInterval(updTime,1000);

  // mode shutter — animate out to /3d; animate back in when returning
  (()=>{
    const sh=document.getElementById('shutter');
    if(!sh)return;
    const rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!rm && sessionStorage.getItem('wj-transit')==='up'){
      sh.classList.add('reveal');
      sh.addEventListener('animationend',()=>sh.classList.remove('reveal'),{once:true});
    }
    sessionStorage.removeItem('wj-transit');
    document.querySelectorAll('a[href="/3d"]').forEach(a=>{
      a.addEventListener('click',e=>{
        if(rm||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||e.button)return;
        e.preventDefault();
        if(sh.classList.contains('cover'))return;
        sessionStorage.setItem('wj-transit','down');
        sh.classList.add('cover');
        sh.addEventListener('animationend',()=>{location.href=a.href;},{once:true});
      });
    });
    addEventListener('pageshow',e=>{if(e.persisted)sh.classList.remove('cover','reveal');});
  })();
</script>

<script>
  // Interests: cross-fade the three hairline SVG figures, synced to the bullets
  // (all motion is CSS; this only swaps which figure is live + pauses off-screen).
  import { initInterestsGraph } from '../scripts/interests-graph';
  import { initBgTerrain } from '../scripts/bg-terrain';
  const iv = document.querySelector('.int-vis');
  if (iv instanceof HTMLElement) initInterestsGraph(iv);
  const sc = document.getElementById('bg-canvas');
  if (sc instanceof HTMLCanvasElement) initBgTerrain(sc);
</script>
</body>
</html>
