---
// Landing page — ported from the v14 design mock.
// Self-contained (its own light theme, fonts, and client script) so it does
// NOT inherit the dark scaffold theme from Base.astro / global.css, which
// still back the /work/[slug] project pages.
//   - <style is:global>  -> emitted unscoped, verbatim
//   - <script is:inline> -> emitted as-is, not bundled/processed by Vite
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#eceef1" />
<title>William Jin — Software Engineer</title>
<meta name="description" content="William Jin — second-year software engineering student at the University of Waterloo. Frontend craft and applied ML." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@300..600&display=swap" />
<style is:global>
  :root{
    --paper:#eceef1; --paper2:#e2e5ea; --ink:#16181c; --mute:#6b6f78; --faint:#a6abb3;
    --rule:rgba(20,24,32,.13); --amber:#bd741b; --amber-rgb:189,116,27;
    --sans:'Geist',system-ui,sans-serif; --mono:'Geist Mono',ui-monospace,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;overflow-x:clip}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
  .m{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
  .wrap{width:100%;max-width:1800px;margin:0 auto;padding:0 clamp(28px,3.5vw,68px);position:relative}

  header{padding:26px 0 16px;border-bottom:1px dashed var(--rule)}
  .hd{display:flex;justify-content:space-between;align-items:center}
  .id{display:flex;align-items:center;gap:13px}
  .icon-ph{width:30px;height:30px;border-radius:8px;background:var(--paper2);border:1px solid var(--rule);display:flex;align-items:center;justify-content:center;position:relative}
  .icon-ph::after{content:"";width:11px;height:11px;border:1.5px solid var(--faint);transform:rotate(45deg)}
  .icon-ph .tag{position:absolute;bottom:-15px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:7px;letter-spacing:.1em;color:var(--faint);white-space:nowrap;text-transform:uppercase}
  .id .nm{font-family:var(--mono);font-size:13px;letter-spacing:.08em;text-transform:uppercase}

  nav{display:flex;gap:12px}
  .nl{position:relative;display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);text-decoration:none;padding:9px 15px;border-radius:7px}
  .nl .fillbg{position:absolute;inset:0;border-radius:7px;background:var(--amber);transform:scaleY(0);transform-origin:bottom;transition:transform .3s ease;z-index:0}
  .nl:hover .fillbg{transform:scaleY(1);transition-delay:.46s}
  .nl .bd{position:absolute;inset:0;width:100%;height:100%;overflow:visible;z-index:1;pointer-events:none}
  .nl .bd rect{fill:none;stroke:var(--amber);stroke-width:1.4;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .46s ease}
  .nl:hover .bd rect{stroke-dashoffset:0}
  .nl .t{position:relative;z-index:2;transition:color .22s ease}
  .nl:hover .t{color:var(--paper);transition-delay:.52s}

  .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:72px;align-items:center;padding:104px 0 120px}
  .greet{margin-bottom:24px}
  h1{font-weight:540;font-size:clamp(44px,5.6vw,82px);line-height:1.04;letter-spacing:-.028em}
  .will{color:var(--amber);filter:blur(11px);opacity:0;display:inline-block;transition:filter .8s ease,opacity .8s ease}
  .will.on{filter:blur(0);opacity:1}
  .role{margin-top:28px;font-size:clamp(22px,2.6vw,32px);font-weight:470;letter-spacing:-.012em}
  .role .mut{color:var(--mute)}
  .school{margin-top:8px;font-size:clamp(22px,2.6vw,32px);font-weight:470;letter-spacing:-.012em;white-space:nowrap}
  .rest{display:inline-block;clip-path:inset(-8% 100% -8% -2%);opacity:0;transition:clip-path .82s cubic-bezier(.7,0,.15,1) .15s,opacity .5s ease .2s}
  .school.on .rest{clip-path:inset(-8% -3% -8% -2%);opacity:1}
  .hero-img{aspect-ratio:4/5;border:1px dashed var(--rule);border-radius:8px;background:repeating-linear-gradient(135deg,transparent 0 22px,rgba(0,0,0,.02) 22px 44px),var(--paper2);display:flex;align-items:center;justify-content:center}
  .hero-img .m{color:var(--faint)}

  .interests{position:relative;height:240vh;border-top:1px solid var(--rule)}
  .sticky{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;justify-content:flex-start;padding:clamp(56px,10vh,104px) 0 48px}
  .int-head{display:flex;justify-content:space-between;align-items:center}
  .int-title{font-size:15px;color:var(--ink);letter-spacing:.14em}
  .int-title .sl{color:var(--amber)}
  .int-prog{height:2px;background:var(--rule);position:relative;margin-top:18px}
  .int-prog i{position:absolute;left:0;top:0;height:100%;width:0;background:var(--amber)}
  .int-stage{position:relative;flex:1;min-height:0;margin-top:8px;overflow:clip}
  .panel{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(20px,3vw,56px);opacity:0;will-change:transform,opacity}
  .panel .meta{padding-left:clamp(12px,3vw,56px);will-change:transform}
  .panel .pidx{font-family:var(--mono);font-size:13px;color:var(--amber);letter-spacing:.12em;margin-bottom:22px}
  .panel .pname{font-size:clamp(28px,3.4vw,44px);font-weight:540;letter-spacing:-.025em;line-height:1.05}
  .panel .pdesc{margin-top:18px;max-width:30ch;font-size:14px;line-height:1.55;color:var(--mute)}
  .panel .dia{height:clamp(280px,56vh,540px);width:auto;max-width:50vw;justify-self:end;will-change:transform}
  .dia [data-draw]{fill:none;stroke:var(--ink);stroke-width:1;stroke-linecap:butt;stroke-linejoin:miter;stroke-miterlimit:8;stroke-dasharray:1;stroke-dashoffset:1}
  .dia .amber{stroke:var(--amber);stroke-width:1.2}
  .dia .struct{stroke:var(--faint);stroke-width:0.7}
  .dia [data-pop]{opacity:0;transform-box:fill-box;transform-origin:center}
  .dia [data-fade]{opacity:0}
  .dia .fill{fill:var(--ink);stroke:none}
  .dia .fillamber{fill:var(--amber);stroke:none}
  .dia .chk{stroke:var(--paper);stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
  .dia .axis{stroke:var(--faint);stroke-width:0.6}
  .dia .ft{fill:rgba(20,24,32,.045);stroke:none}
  .dia .ftt{fill:rgba(20,24,32,.022);stroke:none}
  .dia .fts{fill:rgba(20,24,32,.07);stroke:none}
  .dia .plane{fill:rgba(20,24,32,.04);stroke:none}
  .dia .plane-amber{fill:rgba(var(--amber-rgb),.09);stroke:none}
  .dia .lab{font-family:var(--mono);font-size:6px;letter-spacing:.03em;fill:var(--mute)}
  .dia .lab-amber{fill:var(--amber)}
  .dia .mover{fill:var(--amber);stroke:none;opacity:0}
  .dia .head{fill:var(--ink);stroke:none}
  .dia .head-amber{fill:var(--amber);stroke:none}

  .stack{padding:60px 0 14px;border-top:1px solid var(--rule)}
  .stack-head{display:flex;align-items:center;gap:20px;margin-bottom:18px;flex-wrap:wrap}
  .legend{display:flex;gap:6px;flex-wrap:wrap}
  .lg{font-family:var(--mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--faint);background:none;border:1px solid transparent;border-radius:999px;padding:5px 12px;cursor:pointer;transition:color .35s,border-color .35s,background .35s}
  .lg:hover{color:var(--mute)}
  .lg.active{color:var(--ink);border-color:var(--rule);background:var(--paper)}
  .lg.active::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--amber);margin-right:8px;vertical-align:middle}
  .hint{color:var(--faint);text-transform:none;letter-spacing:.04em;margin-left:auto}
  .drum-win{height:210px;position:relative;perspective:900px;overflow:hidden}
  .drum-win::before,.drum-win::after{content:"";position:absolute;left:0;right:0;height:1px;background:var(--rule);z-index:5;transition:background .3s}
  .drum-win::before{top:50%;margin-top:-35px}
  .drum-win::after{top:50%;margin-top:35px}
  .drum-win:hover::before,.drum-win:hover::after{background:var(--amber)}
  .drum{position:absolute;inset:0;transform-style:preserve-3d}
  .slide{position:absolute;left:0;right:0;height:70px;top:50%;margin-top:-35px;transform-origin:center center;backface-visibility:hidden;display:flex;align-items:center;gap:40px}
  .slide .cat{display:flex;flex-direction:column;gap:5px;width:140px;flex-shrink:0;border-left:2px solid var(--amber);padding-left:16px}
  .slide .cat .ci{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--amber)}
  .slide .cat .cn{font-family:var(--mono);font-size:16px;letter-spacing:.02em;color:var(--ink);text-transform:uppercase}
  .chips{display:flex;flex-wrap:nowrap;gap:10px}
  .chips span{font-family:var(--mono);font-size:13.5px;border:1px solid var(--rule);border-radius:999px;padding:8px 15px;color:var(--ink);background:var(--paper);display:flex;align-items:center;gap:9px;white-space:nowrap;transition:border-color .2s,background .2s,transform .2s}
  .chips span .ic{width:16px;height:16px;flex-shrink:0;background:var(--ink);-webkit-mask:var(--i) center/contain no-repeat;mask:var(--i) center/contain no-repeat;transition:background .2s}
  .chips span:hover{border-color:var(--amber);background:var(--paper2);transform:translateY(-2px)}
  .chips span:hover .ic{background:var(--amber)}

  footer{padding:48px 0 78px;display:flex;flex-direction:column;align-items:center;gap:16px}
  .cta-line{font-size:13px}
  .pill{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--ink);border-radius:999px;padding:6px}
  .pill a{font-family:var(--mono);font-size:12px;letter-spacing:.07em;text-transform:uppercase;padding:11px 20px;border-radius:999px;text-decoration:none;color:var(--ink);transition:background .25s,color .25s}
  .pill a:hover{background:var(--paper2)}
  .pill a.mega{background:var(--amber);color:#fff;font-size:13px;padding:14px 26px}
  .pill a.mega:hover{background:var(--ink);color:#fff}

  /* flair — instrument readout (live telemetry, bottom-left) */
  .hud{position:fixed;left:18px;bottom:15px;z-index:40;font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--faint);text-transform:uppercase;pointer-events:none;display:flex;flex-direction:column;gap:3px;mix-blend-mode:multiply}
  .hud-row{display:flex;gap:8px;align-items:baseline}
  .hud .hk{opacity:.6;min-width:50px}
  .hud .hv{color:var(--mute)}
  .hud .dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--amber);margin-right:5px;vertical-align:middle;animation:blink 2.4s ease-in-out infinite}
  @keyframes blink{0%,100%{opacity:.35}50%{opacity:1}}

  /* flair — viewport instrument: blueprint grid, viewfinder corners, crosshair cursor */
  .grid{position:fixed;inset:0;z-index:-1;pointer-events:none;
    background-image:linear-gradient(to right,rgba(20,24,32,.032) 1px,transparent 1px),linear-gradient(to bottom,rgba(20,24,32,.032) 1px,transparent 1px);
    background-size:clamp(64px,7vw,104px) clamp(64px,7vw,104px);
    -webkit-mask-image:radial-gradient(120% 92% at 50% 36%,#000 50%,transparent 100%);
            mask-image:radial-gradient(120% 92% at 50% 36%,#000 50%,transparent 100%);}
  .frame{position:fixed;inset:0;z-index:35;pointer-events:none}
  .frame .cnr{position:absolute;width:13px;height:13px;border:1px solid var(--faint);opacity:.55}
  .frame .tl{top:13px;left:13px;border-right:0;border-bottom:0}
  .frame .tr{top:13px;right:13px;border-left:0;border-bottom:0}
  .frame .bl{bottom:13px;left:13px;border-right:0;border-top:0}
  .frame .br{bottom:13px;right:13px;border-left:0;border-top:0}
  .cur{display:none}
  @media (pointer:fine){
    body{cursor:none}
    a,button,.chips span,.lg,.icon-ph{cursor:none}
    .cur{display:block;position:fixed;top:0;left:0;z-index:60;pointer-events:none;will-change:transform}
    .cur .ch{position:absolute;background:var(--ink);transition:opacity .2s ease}
    .cur .ch-x{left:-9px;top:-.5px;width:18px;height:1px}
    .cur .ch-y{top:-9px;left:-.5px;width:1px;height:18px}
    .cur .pt{position:absolute;left:-1.5px;top:-1.5px;width:3px;height:3px;border-radius:50%;background:var(--ink);transition:background .2s ease}
    .cur .ring{position:absolute;left:-17px;top:-17px;width:34px;height:34px;border:1px solid var(--amber);border-radius:9px;transform:scale(0);opacity:0;transition:transform .26s cubic-bezier(.2,.8,.2,1),opacity .2s ease}
    .cur.lock .ch{opacity:0}
    .cur.lock .pt{background:var(--amber)}
    .cur.lock .ring{transform:scale(1);opacity:1}
  }

  /* ── responsive: tablets & phones ───────────────────────── */
  @media (max-width:760px){
    /* header — let the nav wrap, tighten the links */
    .hd{flex-wrap:wrap;gap:14px}
    nav{gap:8px;flex-wrap:wrap}
    .nl{padding:8px 11px;font-size:10px}

    /* hero — single column, image below the copy */
    .hero{grid-template-columns:1fr;gap:32px;padding:48px 0 64px}
    h1{font-size:clamp(38px,11vw,60px)}
    .role,.school{font-size:clamp(20px,5.8vw,28px)}
    .hero-img{aspect-ratio:16/10;max-height:260px}

    /* interests — stack the copy over the diagram */
    .int-head{flex-wrap:wrap;gap:6px}
    .int-title{font-size:13px;letter-spacing:.1em}
    .sticky{padding:clamp(36px,6vh,64px) 0 28px}
    .panel{grid-template-columns:1fr;gap:16px;align-content:center}
    .panel .meta{padding-left:0}
    .panel .pname{font-size:clamp(26px,7.2vw,36px)}
    .panel .pdesc{max-width:none;margin-top:12px}
    .panel .dia{justify-self:start;width:100%;max-width:min(100%,440px);height:auto;max-height:34vh}

    /* stack — retire the 3D drum for a clean static list */
    .stack-head .hint{display:none}
    .drum-win{height:auto;overflow:visible;perspective:none}
    .drum-win::before,.drum-win::after{display:none}
    .drum{position:static;transform:none!important;transform-style:flat;display:flex;flex-direction:column;gap:20px}
    .slide{position:static;height:auto;margin:0;transform:none!important;opacity:1!important;flex-direction:column;align-items:flex-start;gap:11px}
    .slide .cat{flex-direction:row;align-items:baseline;gap:10px;width:auto;border-left:0;border-top:2px solid var(--amber);padding:9px 0 0}
    .chips{flex-wrap:wrap}

    /* footer — let the contact pill wrap */
    .pill{flex-wrap:wrap;justify-content:center}

    /* drop the fixed telemetry HUD on small screens */
    .hud{display:none}
  }
</style>
</head>
<body>
<div class="grid" aria-hidden="true"></div>

<div class="wrap">
  <header>
    <div class="hd">
      <div class="id">
        <div class="icon-ph"><span class="tag">icon</span></div>
        <span class="nm">William Jin</span>
      </div>
      <nav>
        <a class="nl" href="#"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">CV</span></a>
        <a class="nl" href="#"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">LinkedIn</span></a>
        <a class="nl" href="#"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">Devpost</span></a>
        <a class="nl" href="#"><span class="fillbg"></span><svg class="bd"><rect x="0" y="0" width="100%" height="100%" rx="7" pathLength="1"/></svg><span class="t">Mail</span></a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="lead" data-par="0.05" data-reveal>
      <div class="greet m">/ index — currently building</div>
      <h1>Hi, I'm <span class="will" id="will">Will</span>.</h1>
      <div class="role">Software Engineer<span class="mut"> · 2nd year</span></div>
      <div class="school" id="school">UW<span class="rest">aterloo</span></div>
    </div>
    <div class="hero-img" data-par="-0.07" data-reveal><span class="m">image — tbd</span></div>
  </section>
</div>

<section class="interests" id="interests">
  <div class="wrap sticky">
    <div class="int-head"><span class="m int-title"><span class="sl">//</span> I'm interested in</span><span class="m" id="intcount">01 / 03</span></div>
    <div class="int-prog"><i id="intbar"></i></div>

    <div class="int-stage">
      <div class="panel" data-i="0">
        <div class="meta"><div class="pidx">01</div><div class="pname">Agentic Applications</div><div class="pdesc">Models that reason, act on tools, and loop on what they observe — not one-shot prompts.</div></div>
        <svg class="dia" viewBox="0 0 320 220">
          <!-- reasoning-core plane (depth) + comet rail -->
          <rect class="plane" data-fade x="46" y="82" width="86" height="56" rx="3"/>
          <path id="react-loop" d="M132 98 C160 82 178 82 206 98 L206 122 C178 138 160 138 132 122 Z" fill="none" stroke="none"/>
          <!-- query in -->
          <circle class="fill" data-pop cx="16" cy="110" r="2.7"/>
          <path data-draw pathLength="1" d="M22 110 H44"/>
          <path class="head" data-fade transform="translate(45 110)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <!-- agent — reasoning core (subject) -->
          <rect data-draw pathLength="1" x="46" y="82" width="86" height="56" rx="3"/>
          <path data-draw pathLength="1" d="M60 98 H112"/>
          <path data-draw pathLength="1" d="M60 108 H120"/>
          <path data-draw pathLength="1" d="M60 118 H102"/>
          <!-- tools (secondary) -->
          <rect class="struct" data-draw pathLength="1" x="206" y="80" width="76" height="60" rx="3"/>
          <circle class="struct" data-draw pathLength="1" cx="226" cy="98" r="7"/>
          <path class="struct" data-draw pathLength="1" d="M231 103 L238 110"/>
          <path class="axis" data-draw pathLength="1" d="M214 113 H274"/>
          <path class="struct" data-draw pathLength="1" d="M226 122 L220 129 L226 136"/>
          <path class="struct" data-draw pathLength="1" d="M240 122 L246 129 L240 136"/>
          <!-- ReAct loop (hero): act -> observe -->
          <path class="amber" data-draw pathLength="1" d="M132 98 C160 82 178 82 206 98"/>
          <path class="head-amber" data-fade transform="translate(206 98) rotate(24)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <path class="amber" data-draw pathLength="1" d="M206 122 C178 138 160 138 132 122"/>
          <path class="head-amber" data-fade transform="translate(132 122) rotate(210)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <!-- final answer out -->
          <path data-draw pathLength="1" d="M89 138 V172"/>
          <path class="head" data-fade transform="translate(89 173) rotate(90)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <circle class="fill" data-pop cx="89" cy="186" r="11"/>
          <path class="chk" data-draw pathLength="1" d="M82 186 L88 192 L97 181"/>
          <!-- labels -->
          <text class="lab" data-fade x="48" y="77">reason</text>
          <text class="lab" data-fade x="206" y="75">tools</text>
          <text class="lab lab-amber" data-fade x="162" y="74">act</text>
          <text class="lab lab-amber" data-fade x="150" y="152">observe</text>
          <!-- comet circling the loop -->
          <circle id="react-comet" class="mover" cx="132" cy="98" r="2.6"/>
        </svg>
      </div>

      <div class="panel" data-i="1">
        <div class="meta"><div class="pidx">02</div><div class="pname">Full Stack</div><div class="pdesc">The whole stack as actual layers — interface on top, logic in the middle, data underneath.</div></div>
        <svg class="dia" viewBox="0 0 320 220">
          <!-- layer 1 — presentation -->
          <path class="ftt" data-fade d="M74 36 L86 28 L236 28 L224 36 Z"/>
          <path class="fts" data-fade d="M224 36 L236 28 L236 62 L224 70 Z"/>
          <rect class="ft" data-fade x="74" y="36" width="150" height="34"/>
          <path class="struct" data-draw pathLength="1" d="M74 36 L86 28 L236 28 L224 36 Z"/>
          <path class="struct" data-draw pathLength="1" d="M224 36 L236 28 L236 62 L224 70 Z"/>
          <rect data-draw pathLength="1" x="74" y="36" width="150" height="34"/>
          <rect class="struct" data-draw pathLength="1" x="90" y="45" width="26" height="18" rx="2"/>
          <path class="struct" data-draw pathLength="1" d="M90 51 H116"/>
          <path class="struct" data-draw pathLength="1" d="M128 49 H206"/>
          <path class="struct" data-draw pathLength="1" d="M128 59 H188"/>
          <!-- layer 2 — logic -->
          <path class="ftt" data-fade d="M74 96 L86 88 L236 88 L224 96 Z"/>
          <path class="fts" data-fade d="M224 96 L236 88 L236 122 L224 130 Z"/>
          <rect class="ft" data-fade x="74" y="96" width="150" height="34"/>
          <path class="struct" data-draw pathLength="1" d="M74 96 L86 88 L236 88 L224 96 Z"/>
          <path class="struct" data-draw pathLength="1" d="M224 96 L236 88 L236 122 L224 130 Z"/>
          <rect data-draw pathLength="1" x="74" y="96" width="150" height="34"/>
          <path class="struct" data-draw pathLength="1" d="M99 100 q-4 0 -4 4 q0 4 -3 4 q3 0 3 4 q0 4 4 4"/>
          <path class="struct" data-draw pathLength="1" d="M113 100 q4 0 4 4 q0 4 3 4 q-3 0 -3 4 q0 4 -4 4"/>
          <path class="struct" data-draw pathLength="1" d="M132 108 H206"/>
          <path class="struct" data-draw pathLength="1" d="M132 119 H188"/>
          <!-- layer 3 — data -->
          <path class="ftt" data-fade d="M74 156 L86 148 L236 148 L224 156 Z"/>
          <path class="fts" data-fade d="M224 156 L236 148 L236 182 L224 190 Z"/>
          <rect class="ft" data-fade x="74" y="156" width="150" height="34"/>
          <path class="struct" data-draw pathLength="1" d="M74 156 L86 148 L236 148 L224 156 Z"/>
          <path class="struct" data-draw pathLength="1" d="M224 156 L236 148 L236 182 L224 190 Z"/>
          <rect data-draw pathLength="1" x="74" y="156" width="150" height="34"/>
          <ellipse class="struct" data-draw pathLength="1" cx="104" cy="169" rx="12" ry="4"/>
          <path class="struct" data-draw pathLength="1" d="M92 169 V179 A12 4 0 0 0 116 179 V169"/>
          <path class="struct" data-draw pathLength="1" d="M128 167 H206"/>
          <path class="struct" data-draw pathLength="1" d="M128 178 H184"/>
          <!-- flow through the stack -->
          <path class="amber" data-draw pathLength="1" d="M92 70 V86"/>
          <path class="head-amber" data-fade transform="translate(92 87) rotate(90)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <path class="amber" data-draw pathLength="1" d="M92 130 V146"/>
          <path class="head-amber" data-fade transform="translate(92 147) rotate(90)" d="M0 0 L-5.5 -2.5 L-5.5 2.5 Z"/>
          <!-- labels -->
          <text class="lab" data-fade x="246" y="56">interface</text>
          <text class="lab" data-fade x="246" y="116">logic</text>
          <text class="lab" data-fade x="246" y="176">data</text>
          <!-- request flowing down the stack -->
          <circle id="fs-flow1" class="mover" cx="92" cy="68" r="2.2"/>
          <circle id="fs-flow2" class="mover" cx="92" cy="128" r="2.2"/>
        </svg>
      </div>

      <div class="panel" data-i="2">
        <div class="meta"><div class="pidx">03</div><div class="pname">Applied ML</div><div class="pdesc">Optimization in practice — stepping down a loss landscape until the model converges.</div></div>
        <svg class="dia" viewBox="0 0 320 220">
          <!-- loss landscape body + convergence basin -->
          <path class="plane" data-fade d="M60 48 C112 70 150 170 172 170 C196 170 232 70 286 48 L286 190 L60 190 Z"/>
          <ellipse class="plane-amber" data-fade cx="172" cy="170" rx="13" ry="9"/>
          <!-- axes + ticks -->
          <path class="axis" data-draw pathLength="1" d="M44 30 V190"/>
          <path class="axis" data-draw pathLength="1" d="M44 190 H300"/>
          <path class="axis" data-draw pathLength="1" d="M40 70 H44"/>
          <path class="axis" data-draw pathLength="1" d="M40 120 H44"/>
          <path class="axis" data-draw pathLength="1" d="M40 170 H44"/>
          <path class="axis" data-draw pathLength="1" d="M110 190 V194"/>
          <path class="axis" data-draw pathLength="1" d="M172 190 V194"/>
          <path class="axis" data-draw pathLength="1" d="M234 190 V194"/>
          <!-- loss curve = the landscape (faint context) -->
          <path class="struct" data-draw pathLength="1" d="M60 48 C112 70 150 170 172 170 C196 170 232 70 286 48"/>
          <!-- descent trajectory = the subject (decreasing steps) -->
          <path id="ml-steps" class="amber" data-draw pathLength="1" d="M96 76 L122 109 L143 141 L159 161 L172 170"/>
          <path class="head-amber" data-fade transform="translate(169 168) rotate(35)" d="M0 0 L-4.5 -2.1 L-4.5 2.1 Z"/>
          <!-- step points -->
          <circle class="fill" data-pop cx="96" cy="76" r="2.7"/>
          <circle class="fill" data-pop cx="122" cy="109" r="2.7"/>
          <circle class="fill" data-pop cx="143" cy="141" r="2.7"/>
          <circle class="fill" data-pop cx="159" cy="161" r="2.7"/>
          <circle class="fillamber" data-pop cx="172" cy="170" r="4.5"/>
          <!-- labels -->
          <text class="lab" data-fade transform="rotate(-90 30 110)" x="30" y="110" text-anchor="middle">loss</text>
          <text class="lab" data-fade x="250" y="202">params</text>
          <text class="lab lab-amber" data-fade x="182" y="166">min</text>
          <!-- roller descending to the optimum -->
          <circle id="ml-roller" class="mover" cx="96" cy="76" r="3"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <section class="stack" data-par="0.04" data-reveal>
    <div class="stack-head">
      <span class="m">// stack</span>
      <div class="legend" id="legend">
        <button class="lg" data-c="0">01 Frontend</button>
        <button class="lg" data-c="1">02 Backend</button>
        <button class="lg" data-c="2">03 ML / AI</button>
        <button class="lg" data-c="3">04 Tools</button>
      </div>
      <span class="m hint">hover to pause</span>
    </div>
    <div class="drum-win" id="drumwin">
      <div class="drum" id="drum">
        <div class="slide"><div class="cat"><span class="ci">01</span><span class="cn">Frontend</span></div><div class="chips">
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/react.svg')"><span class="ic"></span>React</span>
