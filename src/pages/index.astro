          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/pytorch.svg')"><span class="ic"></span>PyTorch</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/huggingface.svg')"><span class="ic"></span>Hugging Face</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/openai.svg')"><span class="ic"></span>OpenAI</span>
        </div></div>
        <div class="slide"><div class="cat"><span class="ci">04</span><span class="cn">Tools</span></div><div class="chips">
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/git.svg')"><span class="ic"></span>Git</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/docker.svg')"><span class="ic"></span>Docker</span>
          <span style="--i:url('https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/figma.svg')"><span class="ic"></span>Figma</span>
